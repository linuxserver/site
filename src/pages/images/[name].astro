---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ImageTile from '@/components/ImageTile.astro';
import Panel from '@/components/Panel.astro';
import PostCard from '@/components/PostCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import ImageLogo from '@/components/ImageLogo.astro';
import CopyButton from '@/components/islands/CopyButton';
import QuickStart from '@/components/islands/QuickStart';
import { withBase } from '@/lib/base';
import { compact, formatDate, grouped, isoDate, relative } from '@/lib/format';
import { composeSnippet, dockerRunSnippet, getAllImages, relatedImages, SNAPSHOT_DATE, type Image } from '@/lib/images';
import { imageJsonLd } from '@/lib/jsonld';
import { getPosts, postsForImage } from '@/lib/posts';
import { SITE } from '@/lib/site';
import { toPostViews } from '@/lib/views';
import { AlertTriangle, ArrowUpRight, Check, Minus } from 'lucide-react';

export function getStaticPaths() {
  return getAllImages().map((image) => ({ params: { name: image.name }, props: { image } }));
}

const { image } = Astro.props as { image: Image };
const related = relatedImages(image, 4);
const posts = await toPostViews(postsForImage(image.name, await getPosts(), 3));
const snippets = {
  compose: composeSnippet(image),
  composeRequired: composeSnippet(image, { optional: false }),
  run: dockerRunSnippet(image),
  runRequired: dockerRunSnippet(image, { optional: false }),
};
const c = image.config ?? {};
const crumbs = [
  { name: 'Images', href: '/images/' },
  { name: image.name, href: image.url },
];
const pull = `docker pull ${SITE.registry}/${image.name}:latest`;
const built = new Date(image.version_timestamp.replace(' ', 'T'));
const description = image.summary.length > 155 ? image.summary.slice(0, 152).replace(/\s+\S*$/, '') + '…' : image.summary;

const tables = [
  {
    id: 'ports',
    title: 'Ports',
    head: ['Port', 'Function'],
    rows: (c.networking === 'host' ? [] : (c.ports ?? [])).map((p) => ({ key: `${p.external}:${p.internal}`, desc: p.desc, optional: p.optional })),
  },
  { id: 'env', title: 'Environment variables', head: ['Variable', 'Function'], rows: (c.env_vars ?? []).map((e) => ({ key: `${e.name}=${e.value}`, desc: e.desc, optional: e.optional })) },
  { id: 'volumes', title: 'Volumes', head: ['Path', 'Function'], rows: (c.volumes ?? []).map((v) => ({ key: v.path, desc: v.desc, optional: v.optional })) },
  { id: 'devices', title: 'Devices', head: ['Device', 'Function'], rows: (c.devices ?? []).map((d) => ({ key: d.path, desc: d.desc, optional: d.optional })) },
  {
    id: 'extra',
    title: 'Other settings',
    head: ['Setting', 'Function'],
    rows: [
      ...(c.caps ?? []).map((x) => ({ key: `cap_add: ${x.cap_add}`, desc: x.desc, optional: x.optional })),
      ...(c.security_opt ?? []).map((x) => ({ key: `security_opt: ${x.compose_var}`, desc: x.desc, optional: x.optional })),
      ...(c.custom ?? []).map((x) => ({ key: `${x.name_compose}: ${Array.isArray(x.value) ? x.value.join(', ') : x.value}`, desc: x.desc, optional: x.optional })),
      ...(c.networking ? [{ key: `network_mode: ${c.networking}`, desc: 'Runs on the host network.', optional: false }] : []),
      ...(c.privileged ? [{ key: 'privileged: true', desc: 'Needs privileged mode.', optional: false }] : []),
      ...(c.hostname ? [{ key: `hostname: ${c.hostname.hostname}`, desc: c.hostname.desc, optional: c.hostname.optional }] : []),
      ...(c.mac_address ? [{ key: `mac_address: ${c.mac_address.mac_address}`, desc: c.mac_address.desc, optional: c.mac_address.optional }] : []),
    ],
  },
].filter((t) => t.rows.length);

const facts: { label: string; value: string; title?: string }[] = [
  { label: 'Pulls last month', value: grouped(image.monthly_pulls) },
  ...(image.hubPulls ? [{ label: 'Docker Hub pulls', value: compact(image.hubPulls), title: grouped(image.hubPulls) }] : []),
  { label: 'GitHub stars', value: grouped(image.stars) },
  { label: 'Last build', value: relative(built, SNAPSHOT_DATE), title: formatDate(built) },
  ...(image.initial_date ? [{ label: 'First build', value: formatDate(image.initial_date) }] : []),
];
const support = [
  { label: 'Read-only root filesystem', ok: !!c.readonly_supported },
  { label: 'Runs as non-root user', ok: !!c.nonroot_supported },
  { label: 'arm64 build', ok: image.arm64 },
];
const links = [
  { label: 'Documentation', href: image.docsUrl },
  ...(c.application_setup ? [{ label: 'Application setup', href: c.application_setup }] : []),
  { label: 'Source on GitHub', href: image.github_url },
  ...(image.project_url ? [{ label: `${image.name} project`, href: image.project_url }] : []),
];
const changelog = image.changelog ?? [];
---

<Layout
  section="images"
  title={`${image.name} Docker image`}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[imageJsonLd(image, Astro.site)]}
>
  <header class="relative overflow-hidden border-b border-[var(--raft-hair)]" data-pagefind-body>
    <div class="raft-aurora pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="raft-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="raft-container relative py-10 md:py-14">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-center">
        <span class="grid size-20 shrink-0 place-items-center rounded-xl border border-[var(--raft-hair-strong)] bg-card p-3 shadow-[var(--raft-shadow)]">
          <ImageLogo image={image} size={56} class="size-14" loading="eager" />
        </span>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{image.name}</h1>
            <span class="rounded-md border border-[var(--raft-hair-strong)] px-2 py-0.5 font-mono text-xs">{image.version}</span>
            {image.deprecated && <span class="rounded-md bg-destructive/15 px-2 py-0.5 font-mono text-xs text-destructive">deprecated</span>}
          </div>
          <p class="mt-3 max-w-3xl text-lg text-muted-foreground">{image.summary}</p>
          {
            image.categories.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Categories">
                {image.categories.map((cat) => (
                  <li>
                    <a
                      href={withBase(`/images/?category=${encodeURIComponent(cat)}`)}
                      class="rounded-md border border-[var(--raft-hair)] bg-background/50 px-2 py-0.5 text-xs text-muted-foreground hover:border-[var(--raft-hair-strong)] hover:text-foreground"
                    >
                      {cat}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
      <div class="mt-8 flex max-w-2xl items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] bg-[var(--raft-code-bg)] py-1 pr-1 pl-4 font-mono text-sm">
        <span class="min-w-0 flex-1 truncate"><span class="text-primary" aria-hidden="true">$ </span>{pull}</span>
        <CopyButton client:visible text={pull} label="Copy docker pull command" variant="secondary" />
      </div>
    </div>
  </header>

  <div class="raft-container mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_19rem]">
    <div class="min-w-0 space-y-12" data-pagefind-body>
      {
        image.deprecated && (
          <div role="note" class="flex gap-3 rounded-[var(--radius)] border border-destructive/40 bg-destructive/10 p-4">
            <AlertTriangle className="mt-0.5 size-5 shrink-0 text-destructive" aria-hidden="true" />
            <div>
              <p class="font-semibold">This image is deprecated</p>
              <p class="mt-1 text-sm text-muted-foreground">
                It is no longer maintained and receives no further updates. The details below are kept for reference; you can find{' '}
                <a href={withBase('/images/')} class="font-medium text-foreground underline underline-offset-4">maintained alternatives</a> in the catalogue.
              </p>
            </div>
          </div>
        )
      }

      <section aria-labelledby="quick-start">
        <h2 id="quick-start" class="text-xl font-semibold tracking-tight">Quick start</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Generated from the image's own configuration. Replace the <code class="font-mono text-foreground">/path/to</code> folders with real paths on your host.
        </p>
        <Panel class="mt-4" bodyClass="bg-[var(--raft-code-bg)]">
          <QuickStart client:visible name={image.name} {...snippets} />
        </Panel>
      </section>

      {
        tables.length > 0 && (
          <section aria-labelledby="parameters" class="space-y-6">
            <h2 id="parameters" class="text-xl font-semibold tracking-tight">Parameters</h2>
            {tables.map((t) => (
              <div class="raft-panel overflow-x-auto">
                <table class="w-full text-left text-sm">
                  <caption class="border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] px-4 py-2.5 text-left font-mono text-xs text-muted-foreground uppercase">
                    {t.title}
                  </caption>
                  <thead class="sr-only">
                    <tr>
                      <th scope="col">{t.head[0]}</th>
                      <th scope="col">{t.head[1]}</th>
                      <th scope="col">Required</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[var(--raft-hair)]">
                    {t.rows.map((r) => (
                      <tr class="align-top">
                        <th scope="row" class="w-[40%] px-4 py-3 font-mono text-[0.8125rem] font-normal break-all text-foreground">
                          {r.key}
                        </th>
                        <td class="px-4 py-3 text-muted-foreground">{r.desc}</td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                          <span
                            class:list={[
                              'rounded px-1.5 py-0.5 font-mono text-[0.6875rem]',
                              r.optional ? 'border border-[var(--raft-hair)] text-muted-foreground' : 'bg-accent text-accent-foreground',
                            ]}
                          >
                            {r.optional ? 'optional' : 'required'}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </section>
        )
      }

      <section aria-labelledby="arch">
        <h2 id="arch" class="text-xl font-semibold tracking-tight">Architectures</h2>
        <p class="mt-2 text-sm text-muted-foreground">Pulling <code class="font-mono text-foreground">:latest</code> picks the right one for your host automatically.</p>
        <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            image.architectures.map((a) => (
              <li class="raft-panel flex items-baseline justify-between gap-4 px-4 py-3">
                <span class="font-mono text-[0.8125rem]">{a.arch}</span>
                <code class="font-mono text-xs text-muted-foreground">{a.tag}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="tags">
        <h2 id="tags" class="text-xl font-semibold tracking-tight">Tags</h2>
        <ul class="raft-panel mt-4 grid grid-cols-1 divide-[var(--raft-hair)] md:grid-cols-2 [&>li]:border-b [&>li]:border-[var(--raft-hair)] md:[&>li:nth-child(odd)]:border-r">
          {
            image.tags.map((t) => (
              <li class="flex items-baseline justify-between gap-4 px-4 py-2.5">
                <code class="font-mono text-[0.8125rem] text-foreground">:{t.tag}</code>
                <span class="text-right text-sm text-muted-foreground">{t.desc}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        changelog.length > 0 && (
          <section aria-labelledby="changelog">
            <h2 id="changelog" class="text-xl font-semibold tracking-tight">Changelog</h2>
            <ol class="relative mt-6 space-y-5 border-l border-[var(--raft-hair-strong)] pl-6">
              {changelog.slice(0, 8).map((e, i) => (
                <li class="relative">
                  <span
                    class:list={['absolute top-1.5 -left-[1.6rem] size-2.5 rounded-full border-2 border-background', i === 0 ? 'bg-primary' : 'bg-[var(--raft-hair-strong)]']}
                    aria-hidden="true"
                  />
                  <time datetime={e.date} class="font-mono text-xs text-muted-foreground tabular-nums">
                    {formatDate(e.date)}
                  </time>
                  <p class="mt-0.5 text-sm">{e.desc}</p>
                </li>
              ))}
            </ol>
            {changelog.length > 8 && (
              <details class="mt-5 pl-6">
                <summary class="cursor-pointer font-mono text-xs text-muted-foreground hover:text-foreground">{changelog.length - 8} earlier entries</summary>
                <ol class="mt-4 space-y-3">
                  {changelog.slice(8).map((e) => (
                    <li class="text-sm">
                      <time datetime={e.date} class="mr-3 font-mono text-xs text-muted-foreground tabular-nums">
                        {e.date}
                      </time>
                      {e.desc}
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </section>
        )
      }
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start" aria-label={`About ${image.name}`}>
      <div class="raft-panel p-5">
        <h2 class="raft-eyebrow">At a glance</h2>
        <dl class="mt-4 space-y-3 text-sm">
          {
            facts.map((f) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">{f.label}</dt>
                <dd class="font-mono text-foreground tabular-nums" title={f.title}>
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
        <ul class="mt-5 space-y-2 border-t border-[var(--raft-hair)] pt-4 text-sm">
          {
            support.map((x) => (
              <li class="flex items-center gap-2">
                {x.ok ? <Check className="size-4 text-[var(--raft-ok)]" aria-hidden="true" /> : <Minus className="size-4 text-muted-foreground" aria-hidden="true" />}
                <span class={x.ok ? 'text-foreground' : 'text-muted-foreground'}>{x.label}</span>
                <span class="sr-only">: {x.ok ? 'yes' : 'no'}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <nav class="raft-panel p-2" aria-label="Resources">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener" class="flex items-center justify-between gap-2 rounded-md px-3 py-2 text-sm hover:bg-muted">
                  <span class="truncate">{l.label}</span>
                  <ArrowUpRight className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="px-1 font-mono text-[0.6875rem] text-muted-foreground">
        Data from api.linuxserver.io, <time datetime={isoDate(SNAPSHOT_DATE)}>{formatDate(SNAPSHOT_DATE)}</time>
      </p>
    </aside>
  </div>

  {
    posts.length > 0 && (
      <section class="raft-container pt-20" aria-labelledby="posts-title">
        <SectionHead eyebrow="Writing" title={`Posts about ${image.name}`} id="posts-title" />
        <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-3">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="raft-container pt-20" aria-labelledby="related-title">
        <SectionHead eyebrow="Related" title="Similar images" id="related-title" link={{ label: 'Browse all', href: withBase('/images/') }} />
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => <ImageTile image={r} />)}
        </div>
      </section>
    )
  }
</Layout>
