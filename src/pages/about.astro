---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import GrowthChart from '@/components/GrowthChart.astro';
import PageHeader from '@/components/PageHeader.astro';
import Panel from '@/components/Panel.astro';
import SectionHead from '@/components/SectionHead.astro';
import StatTile from '@/components/StatTile.astro';
import { withBase } from '@/lib/base';
import { getAllImages, getCategories } from '@/lib/images';
import { LINKS, MISSION, PILLARS, SUPPORTERS } from '@/lib/site';
import { SINCE_YEAR, stat } from '@/lib/stats';
import { getTeam } from '@/lib/team';
import { ArrowUpRight } from 'lucide-react';

const team = getTeam();
const topCats = getCategories().slice(0, 10);
const catMax = topCats[0]?.count ?? 1;

// New images per year from first-build dates (deprecated images count: they were part of the fleet).
const years = new Map<number, number>();
for (const i of getAllImages()) if (i.initial_date) years.set(+i.initial_date.slice(0, 4), (years.get(+i.initial_date.slice(0, 4)) ?? 0) + 1);
let total = 0;
const growth = [...years]
  .sort((a, b) => a[0] - b[0])
  .map(([year, added]) => ({ year, added, total: (total += added) }));
const crumbs = [{ name: 'About', href: '/about/' }];
---

<Layout section="about" title="About" description="Who LinuxServer.io are: volunteers building standardised, regularly updated, well documented Docker images since 2015." breadcrumbs={crumbs}>
  <PageHeader eyebrow="About" title="Volunteers, building the boring parts properly" crumbs={crumbs}>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">{MISSION}</p>
  </PageHeader>

  <section class="raft-container pt-14" aria-labelledby="stats-title">
    <h2 id="stats-title" class="sr-only">LinuxServer.io in numbers</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <StatTile stat={stat.hubPulls} class="sm:col-span-2" hero />
      <StatTile stat={stat.images} />
      <StatTile stat={stat.team} />
      <StatTile stat={stat.stars} />
      <StatTile stat={stat.monthlyPulls} />
      <StatTile stat={stat.backers} />
      <StatTile stat={stat.years} />
    </div>
  </section>

  <section class="raft-container pt-24" aria-labelledby="growth-title">
    <SectionHead eyebrow="History" title={`A decade of images, since ${SINCE_YEAR}`} id="growth-title" description="How the fleet has grown, counted from each image's first build. Images that were later deprecated are included for the years they were part of it." />
    <div class="mt-10 grid grid-cols-1 gap-3 lg:grid-cols-[1.4fr_1fr]">
      <Panel title="fleet size by year" bodyClass="p-6 pt-12">
        <GrowthChart growth={growth} />
      </Panel>
      <Panel title="largest categories" bodyClass="p-5">
        <ol class="space-y-2.5">
          {
            topCats.map((c) => (
              <li>
                <a href={withBase(`/images/?category=${encodeURIComponent(c.name)}`)} class="group block">
                  <span class="flex items-baseline justify-between text-sm">
                    <span class="group-hover:text-primary">{c.name}</span>
                    <span class="font-mono text-xs text-muted-foreground tabular-nums">{c.count}</span>
                  </span>
                  <span class="mt-1 block h-1.5 rounded-full bg-[var(--raft-bar-track)]" aria-hidden="true">
                    <span class="block h-full rounded-full bg-[var(--raft-bar)] opacity-80" style={`width:${(c.count / catMax) * 100}%`} />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </Panel>
    </div>
  </section>

  <section class="raft-container pt-24" aria-labelledby="principles-title">
    <SectionHead eyebrow="Principles" title="What every image gets" id="principles-title" />
    <ul class="mt-10 grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        PILLARS.map((p, i) => (
          <li class="raft-panel p-6">
            <p class="font-mono text-xs text-muted-foreground">0{i + 1}</p>
            <h3 class="mt-2 text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-muted-foreground">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="raft-container pt-24" aria-labelledby="team">
    <SectionHead
      eyebrow="Team"
      title={`${team.length} people, many time zones`}
      id="team"
      description="The public members of our GitHub organisation. Everyone gives their free time."
      link={{ label: 'All on GitHub', href: LINKS.team }}
    />
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        team.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener" class="raft-panel raft-glow-edge flex flex-col items-center p-4 text-center transition-colors hover:bg-muted/40">
              {m.avatar ? (
                <Image src={m.avatar} alt="" width={64} height={64} densities={[1, 2]} class="size-16 rounded-full border border-[var(--raft-hair)]" />
              ) : (
                <span class="size-16 rounded-full bg-muted" />
              )}
              <span class="mt-3 w-full truncate text-sm font-medium">{m.name ?? m.login}</span>
              <span class="w-full truncate font-mono text-xs text-muted-foreground">@{m.login}</span>
              <span class="sr-only">on GitHub (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="raft-container pt-24" aria-labelledby="thanks-title">
    <SectionHead eyebrow="Thanks" title="Supported by" id="thanks-title" link={{ label: 'Donate', href: withBase('/donate/') }} />
    <ul class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius)] border border-[var(--raft-hair)] bg-[var(--raft-hair)] sm:grid-cols-2 lg:grid-cols-5">
      {
        SUPPORTERS.map((s) => (
          <li class="bg-card p-5">
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-semibold hover:text-primary">
              {s.name} <ArrowUpRight className="size-3.5 text-muted-foreground" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
            </a>
            <p class="mt-2 text-sm text-muted-foreground">{s.contribution}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
