---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { LINKS, SUPPORT_CHANNELS } from '@/lib/site';
import { ArrowUpRight, BookOpen, Check, MessagesSquare } from 'lucide-react';

const checklist = [
  'Which image and tag you are running, and how you started it (your compose file or docker run command)',
  'The container log: docker logs <container>',
  'What you expected to happen, and what happened instead',
  'Your host: OS, architecture, and Docker version',
];
const crumbs = [{ name: 'Support', href: '/support/' }];
---

<Layout section="support" title="Support" description="Where to get help with LinuxServer.io images: documentation, Discord, our Discussions forum and GitHub." breadcrumbs={crumbs}>
  <PageHeader
    eyebrow="Support"
    title="Get help from people who build the images"
    lede="We make easy-to-use, well documented images. Start with the docs; if you are still stuck, the team and the community are on Discord and our forum."
    crumbs={crumbs}
  />
  <div class="raft-container pt-12">
    <ol class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        SUPPORT_CHANNELS.map((c, i) => (
          <li class="raft-panel raft-glow-edge relative flex flex-col p-6">
            <div class="flex items-center justify-between">
              <span class="grid size-10 place-items-center rounded-md border border-[var(--raft-hair)] bg-[var(--raft-surface)] text-primary">
                {c.icon === 'docs' && <BookOpen className="size-5" aria-hidden="true" />}
                {c.icon === 'discussions' && <MessagesSquare className="size-5" aria-hidden="true" />}
                {c.icon === 'discord' && <Icon name="discord" class="size-5" />}
                {c.icon === 'github' && <Icon name="github" class="size-5" />}
              </span>
              <span class="font-mono text-xs text-muted-foreground">step 0{i + 1}</span>
            </div>
            <h2 class="mt-5 text-xl font-semibold tracking-tight">
              <a href={c.href} target="_blank" rel="noopener" class="after:absolute after:inset-0 after:content-[''] hover:text-primary">
                {c.name}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </h2>
            <p class="mt-2 text-muted-foreground">{c.summary}</p>
            <p class="mt-auto flex items-center justify-between gap-3 pt-5 text-sm">
              <span><span class="font-mono text-xs text-muted-foreground uppercase">Best for</span> {c.bestFor}</span>
              <ArrowUpRight className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <section aria-labelledby="ask-title">
        <h2 id="ask-title" class="text-2xl font-semibold tracking-tight">Asking a good question</h2>
        <p class="mt-3 text-muted-foreground">You will get a faster answer if you include:</p>
        <ul class="mt-5 space-y-3">
          {
            checklist.map((c) => (
              <li class="flex gap-3">
                <Check className="mt-0.5 size-4 shrink-0 text-[var(--raft-ok)]" aria-hidden="true" />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="bug-title" class="raft-panel p-6">
        <h2 id="bug-title" class="text-2xl font-semibold tracking-tight">Found a bug?</h2>
        <p class="mt-3 text-muted-foreground">
          If something does not work as documented, open an issue on the GitHub repository for that image. Every image page links to its repository. Pull
          requests are welcome too.
        </p>
        <a href={LINKS.github} target="_blank" rel="noopener" class="mt-6 inline-flex h-10 items-center gap-2 rounded-md bg-foreground px-4 text-sm font-medium text-background hover:opacity-90">
          <Icon name="github" class="size-4" /> github.com/linuxserver<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </section>
    </div>
  </div>
</Layout>
