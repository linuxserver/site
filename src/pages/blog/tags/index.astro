---
import Tags from '@design/pages/Tags.astro';
import { collectTags, getAuthors, getPosts } from '@/lib/posts';

const posts = await getPosts();
const authors = (await getAuthors(posts)).map(({ author, count, initials, url }) => ({
  id: author.id,
  name: author.data.name,
  github: author.data.github,
  bio: author.data.bio,
  role: author.data.role,
  initials,
  count,
  url,
}));
---

<Tags tags={collectTags(posts)} authors={authors} totalPosts={posts.length} />
