---
import BlogList from '@design/pages/BlogList.astro';
import { getAuthors, getPosts, paginate, postsByAuthor } from '@/lib/posts';
import { toPostViews } from '@/lib/views';
import type { AuthorView } from '@/designs/types';
import { topTags } from '../_list';

export async function getStaticPaths() {
  const authors = await getAuthors(await getPosts());
  return authors.map(({ author, count, initials, url }) => ({
    params: { author: author.id },
    props: {
      author: {
        id: author.id,
        name: author.data.name,
        github: author.data.github,
        bio: author.data.bio,
        role: author.data.role,
        initials,
        count,
        url,
      } satisfies AuthorView,
    },
  }));
}

const { author } = Astro.props as { author: AuthorView };
const posts = await postsByAuthor(await getPosts(), author.id);
// Author pages list everything on one page
const p = paginate(posts, 1, Math.max(1, posts.length), `/blog/authors/${author.id}/`);
const props = {
  kind: 'author' as const,
  heading: author.name,
  description: `${posts.length} post${posts.length === 1 ? '' : 's'} by ${author.name} on the LinuxServer.io blog.`,
  page: { ...p, data: await toPostViews(p.data) },
  topTags: await topTags(),
  author,
};
---

<BlogList {...props} />
