---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import Otter from '@/components/Otter.astro';
import backers from '@/data/backers.json';
import { withBase } from '@/lib/base';
import { grouped } from '@/lib/format';
import { DONATE_URL, LINKS, SUPPORTERS } from '@/lib/site';
import { stat } from '@/lib/stats';
import { ArrowUpRight, Heart } from 'lucide-react';

const otherWays = [
  { title: 'Contribute code', body: 'Every image is open source. Pull requests to fix bugs or improve documentation are welcome.', href: LINKS.github, label: 'GitHub' },
  { title: 'Help other users', body: 'Answering a question on Discord or the forum frees up time for the team to build.', href: LINKS.discord, label: 'Discord' },
  { title: 'Spread the word', body: 'Write about your setup, star the repositories you use, and point people to the docs.', href: '/blog/', label: 'Our blog' },
];
const crumbs = [{ name: 'Donate', href: '/donate/' }];
---

<Layout section="donate" title="Donate" description="LinuxServer.io is run entirely by volunteers. Donations on Open Collective keep our build infrastructure running." breadcrumbs={crumbs}>
  <PageHeader
    eyebrow="Donate"
    title="Keep the fleet afloat"
    lede="Everyone at LinuxServer.io is a volunteer. We don't get paid to do this; we make the most of our free time to keep improving what we do. Even the smallest donation helps keep everything up and running."
    crumbs={crumbs}
  />

  <div class="raft-container grid grid-cols-1 gap-3 pt-12 lg:grid-cols-[1.3fr_1fr]">
    <section aria-labelledby="oc-title" class="raft-panel relative overflow-hidden p-8 md:p-10">
      <div class="raft-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <p class="raft-eyebrow flex items-center gap-2"><Icon name="opencollective" class="size-3.5" /> Open Collective</p>
        <h2 id="oc-title" class="mt-4 text-3xl font-semibold tracking-tight">Back us, transparently</h2>
        <p class="mt-3 max-w-lg text-muted-foreground">
          Donations go through Open Collective, where every expense is public. One-off or monthly, in any amount.
        </p>
        <p class="mt-8 flex items-baseline gap-3">
          <span class="text-5xl font-semibold tracking-[-0.045em]">{grouped(backers.backers)}</span>
          <span class="text-muted-foreground">backers so far</span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={DONATE_URL} class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-medium text-primary-foreground hover:brightness-110">
            <Heart className="size-4" aria-hidden="true" /> Donate on Open Collective
          </a>
          <a href={LINKS.opencollective} class="inline-flex h-11 items-center gap-2 rounded-md border border-[var(--raft-hair-strong)] bg-background/60 px-5 font-medium hover:bg-muted">
            See the budget <ArrowUpRight className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
    <section aria-labelledby="value-title" class="raft-panel flex flex-col p-8">
      <h2 id="value-title" class="raft-eyebrow">What you are supporting</h2>
      <dl class="mt-6 grid grid-cols-2 gap-6">
        {
          [stat.images, stat.monthlyPulls, stat.hubPulls, stat.updatedThisWeek].map((x) => (
            <div>
              <dt class="text-sm text-muted-foreground">{x.label}</dt>
              <dd class="mt-1 text-3xl font-semibold tracking-[-0.04em]">
                {x.value}
                {x.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-auto flex justify-end pt-6">
        <Otter pose="wave" class="w-24" />
      </div>
    </section>
  </div>

  <section class="raft-container pt-20" aria-labelledby="supporters-title">
    <p class="raft-eyebrow"><span class="text-primary" aria-hidden="true">//</span> Supporters</p>
    <h2 id="supporters-title" class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">Organisations that have helped</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      We wouldn't be where we are without our users, but special thanks go to the organisations who have donated their time, credit or hardware.
    </p>
    <ul class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius)] border border-[var(--raft-hair)] bg-[var(--raft-hair)] sm:grid-cols-2 lg:grid-cols-5">
      {
        SUPPORTERS.map((s) => (
          <li class="flex flex-col bg-card p-5">
            <a href={s.href} target="_blank" rel="noopener" class="text-lg font-semibold hover:text-primary">
              {s.name}<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <p class="mt-2 text-sm text-muted-foreground">{s.contribution}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="raft-container pt-20" aria-labelledby="other-title">
    <h2 id="other-title" class="text-2xl font-semibold tracking-tight">Other ways to help</h2>
    <ul class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-3">
      {
        otherWays.map((w) => (
          <li class="raft-panel p-6">
            <h3 class="font-semibold">{w.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{w.body}</p>
            <a
              href={w.href.startsWith('/') ? withBase(w.href) : w.href}
              class="mt-4 inline-flex items-center gap-1 text-sm font-medium hover:text-primary"
              {...(w.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {w.label} <ArrowUpRight className="size-3.5" aria-hidden="true" />
              {w.href.startsWith('http') && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
