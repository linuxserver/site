---
import Otter from '@/components/shared/Otter.astro';
import type { DonateProps } from '@/designs/types';
import { grouped } from '@/lib/format';
import { DONATE_URL, LINKS } from '@/lib/site';
import { ArrowUpRight, Code2, Globe, Heart, LifeBuoy, Megaphone, Receipt, Server } from 'lucide-react';
import Layout from '../Layout.astro';
import { withBase } from '@/lib/base';

type Props = DonateProps;
const { stats, supporters, backers } = Astro.props;
const yearly = Math.round(backers.yearly_income / 100);
const otherWays = [
  { icon: Code2, title: 'Contribute code', body: 'Pull requests to any of our repositories are welcome, from typo fixes to new images.', href: LINKS.github, label: 'Our GitHub' },
  { icon: LifeBuoy, title: 'Help others', body: 'Answer a question on Discord or the forum. Support is a community effort.', href: LINKS.discord, label: 'Join Discord' },
  { icon: Megaphone, title: 'Spread the word', body: 'Star the repos you use and tell people where your containers come from.', href: LINKS.github, label: 'Star on GitHub' },
];
---

<Layout
  title="Donate"
  section="donate"
  description={`LinuxServer.io is run entirely by volunteers. Join ${stats.backers.value} backers on Open Collective and help keep the build servers running.`}
  breadcrumbs={[{ name: 'Donate', href: '/donate/' }]}
  footerOtter={false}
>
  <section class="cur-band text-white" aria-labelledby="title">
    <div class="cur-container grid grid-cols-[minmax(0,1fr)] items-center gap-10 py-14 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:py-20">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-white/85">
          <a href={withBase('/')} class="hover:underline">Home</a> <span aria-hidden="true">›</span> <span aria-current="page">Donate</span>
        </nav>
        <h1 id="title" class="mt-5 font-heading text-4xl font-semibold tracking-tight md:text-6xl">Nobody here is paid. That’s the point.</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/95">
          Everyone at LinuxServer.io is a volunteer, giving their free time to keep {stats.images.value} images built, updated and supported. Even the smallest
          donation helps keep everything up and running. We are eternally grateful for every one.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={DONATE_URL} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 rounded-lg bg-white px-6 font-heading text-lg font-semibold text-[#0f172a] hover:bg-white/90">
            <Heart className="size-5 text-[#9d174d]" aria-hidden="true" /> Donate on Open Collective<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a href={LINKS.opencollective} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-1.5 px-2 font-heading font-semibold text-white hover:underline">
            See our budget <ArrowUpRight className="size-4" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-white/15 bg-[#0f0a24]/45 p-6 backdrop-blur md:p-8">
        <dl class="grid grid-cols-2 gap-6">
          <div class="flex flex-col">
            <dt class="text-sm text-white/90">backers on Open Collective</dt>
            <dd class="order-first font-heading text-4xl font-semibold">{grouped(backers.backers)}</dd>
          </div>
          <div class="flex flex-col">
            <dt class="text-sm text-white/90">raised in the last year ({backers.currency})</dt>
            <dd class="order-first font-heading text-4xl font-semibold">{yearly.toLocaleString('en-GB', { style: 'currency', currency: backers.currency, maximumFractionDigits: 0 })}</dd>
          </div>
          <div class="flex flex-col">
            <dt class="text-sm text-white/90">{stats.monthlyPulls.label}</dt>
            <dd class="order-first font-heading text-4xl font-semibold">{stats.monthlyPulls.value}</dd>
          </div>
          <div class="flex flex-col">
            <dt class="text-sm text-white/90">{stats.team.label}</dt>
            <dd class="order-first font-heading text-4xl font-semibold">{stats.team.value}</dd>
          </div>
        </dl>
        <p class="mt-6 border-t border-white/20 pt-4 text-sm text-white/90">
          Every transaction is public on Open Collective, so you can see exactly where the money goes.
        </p>
      </div>
    </div>
  </section>

  <section class="cur-container mt-20" aria-labelledby="where">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <h2 id="where" class="font-heading text-3xl font-semibold">Where it goes</h2>
        <p class="mt-3 text-muted-foreground">
          Donations go into our budget on Open Collective, which helps keep everything up and running so we can keep improving what we do.
        </p>
      </div>
      <ul class="grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-3">
        {
          [
            { icon: Server, t: 'Running costs', b: 'The infrastructure behind the build pipeline, the docs and this site.' },
            { icon: Receipt, t: 'Spent in the open', b: 'Every contribution and expense is listed publicly on Open Collective.' },
            { icon: Globe, t: 'For everyone', b: 'Our images are free for everyone, and always will be.' },
          ].map((x) => (
            <li class="cur-card p-5">
              <span class="grid size-10 place-items-center rounded-lg bg-accent text-accent-foreground">
                <x.icon className="size-5" aria-hidden="true" />
              </span>
              <h3 class="mt-4 font-heading font-semibold">{x.t}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{x.b}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cur-container mt-20" aria-labelledby="supporters">
    <h2 id="supporters" class="font-heading text-3xl font-semibold">Supporters</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      We wouldn’t be where we are without our users, but special thanks go to the organisations who have donated their time, credit or hardware.
    </p>
    <ul class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
      {
        supporters.map((s) => (
          <li class="flex flex-col bg-card p-5">
            <h3 class="font-heading text-lg font-semibold">
              <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary hover:underline">
                {s.name}
                <ArrowUpRight className="size-4 opacity-60" aria-hidden="true" />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.contribution}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cur-container mt-20" aria-labelledby="other">
    <div class="grid grid-cols-[minmax(0,1fr)] items-end gap-8 md:grid-cols-[minmax(0,1fr)_14rem]">
      <div>
        <h2 id="other" class="font-heading text-3xl font-semibold">Other ways to help</h2>
        <ul class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-3">
          {
            otherWays.map((w) => (
              <li class="cur-card flex flex-col p-5">
                <w.icon className="size-5 text-primary" aria-hidden="true" />
                <h3 class="mt-3 font-heading font-semibold">{w.title}</h3>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted-foreground">{w.body}</p>
                <a href={w.href} target="_blank" rel="noopener" class="cur-link mt-4 text-sm font-medium">
                  {w.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <Otter pose="wave" class="hidden w-full md:block" />
    </div>
  </section>
</Layout>
