---
import ImageLogo from '@/components/shared/ImageLogo.astro';
import Otter from '@/components/shared/Otter.astro';
import type { NotFoundProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { Search } from 'lucide-react';
import Layout from '../Layout.astro';

type Props = NotFoundProps;
const { popular } = Astro.props;
---

<Layout title="Page not found" noindex footerOtter={false} description="This page does not exist. Search the catalogue or head back home.">
  <div class="cur-container max-w-3xl py-16 text-center md:py-24">
    <div class="mx-auto w-48">
      <Otter pose="peek" ledge class="w-full" />
    </div>
    <p class="cur-eyebrow mt-8">Error 404</p>
    <h1 class="mt-2 font-heading text-4xl font-semibold tracking-tight md:text-5xl">This page swam off</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
      We could not find what you were looking for. It may have moved when we rebuilt the site. Old blog links now live under <code class="rounded bg-muted px-1 font-mono text-[0.9em]">/blog/</code>.
    </p>
    <form action={withBase('/images/')} method="get" role="search" class="relative mx-auto mt-8 max-w-lg">
      <label for="nf-q" class="sr-only">Search images</label>
      <Search className="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-muted-foreground" aria-hidden="true" />
      <input id="nf-q" name="q" type="search" placeholder="Search images" class="h-12 w-full rounded-lg border border-input bg-card pr-28 pl-12 outline-none focus-visible:border-ring focus-visible:ring-4 focus-visible:ring-ring/25" />
      <button type="submit" class="absolute top-1/2 right-1.5 h-9 -translate-y-1/2 rounded-md bg-primary px-4 font-heading font-semibold text-primary-foreground">Search</button>
    </form>
    <p class="mt-5 text-sm">
      <a href={withBase('/')} class="cur-link">Go home</a>
      <span aria-hidden="true" class="mx-1.5">·</span>
      <a href={withBase('/blog/')} class="cur-link">Read the blog</a>
      <span aria-hidden="true" class="mx-1.5">·</span>
      <a href={withBase('/support/')} class="cur-link">Get support</a>
    </p>

    <section class="mt-16 text-left" aria-labelledby="popular">
      <h2 id="popular" class="cur-eyebrow mb-4 text-center">Or try a popular image</h2>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          popular.map((i) => (
            <li>
              <a href={withBase(i.url)} class="flex items-center gap-3 rounded-lg border border-border bg-card p-3 hover:bg-muted">
                <ImageLogo image={i} size={32} class="size-8 shrink-0 rounded" />
                <span class="truncate font-heading font-semibold">{i.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
