---
import { getImage, Image } from 'astro:assets';
import ImageLogo from '@/components/shared/ImageLogo.astro';
import PostBody from '@/components/shared/PostBody.astro';
import type { PostProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { formatDate, formatDateLong, isoDate } from '@/lib/format';
import { postJsonLd } from '@/lib/jsonld';
import { ArrowLeft, ArrowRight, Clock, Pencil } from 'lucide-react';
import Layout from '../Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';

type Props = PostProps;
const { post, Content, headings, newer, older, related, images, editUrl } = Astro.props;
const heroOg = await getImage({ src: post.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const toc = headings.filter((h) => h.depth === 2);
---

<Layout
  title={post.title}
  section="blog"
  description={post.excerpt}
  image={post.hero}
  imageAlt={post.heroAlt || undefined}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.updated}
  author={post.byline?.name}
  tags={post.tags.map((t) => t.name)}
  breadcrumbs={[
    { name: 'Blog', href: '/blog/' },
    { name: post.title, href: post.url.replace(withBase('/'), '/') },
  ]}
  jsonLd={[postJsonLd(post, new URL(heroOg.src, Astro.site).toString(), Astro.site)]}
>
  <article>
    <header class="cur-container pt-10">
      <div class="mx-auto max-w-3xl">
        <Breadcrumbs items={[{ name: 'Blog', href: '/blog/' }]} current={post.title} />
        <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tags">
          {
            post.tags.slice(0, 6).map((t) => (
              <li>
                <a href={t.url} class="rounded-full border border-border px-2.5 py-0.5 text-xs font-medium text-muted-foreground hover:border-primary hover:text-primary">
                  {t.name}
                </a>
              </li>
            ))
          }
        </ul>
        <h1 class="mt-4 font-heading text-4xl leading-[1.08] font-semibold tracking-tight md:text-5xl">{post.title}</h1>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-border py-4 text-sm text-muted-foreground">
          {
            post.byline && (
              <span class="flex items-center gap-2.5">
                <span class="grid size-8 place-items-center rounded-full bg-accent font-heading text-xs font-semibold text-accent-foreground" aria-hidden="true">
                  {post.byline.initials}
                </span>
                {post.byline.url ? (
                  <a href={post.byline.url} class="font-medium text-foreground hover:underline">
                    {post.byline.name}
                  </a>
                ) : (
                  <span class="font-medium text-foreground">{post.byline.name}</span>
                )}
              </span>
            )
          }
          <time datetime={isoDate(post.date)}>{formatDateLong(post.date)}</time>
          <span class="flex items-center gap-1.5"><Clock className="size-4" aria-hidden="true" />{post.readingTime} min read</span>
        </div>
      </div>
      <div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-xl border border-border bg-muted">
        <Image
          src={post.hero}
          alt={post.heroAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          class:list={['w-full', post.heroIsDefault ? 'aspect-[3/1] object-cover' : 'max-h-[34rem] object-cover']}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </header>

    <div class="cur-container mt-12 grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,48rem)_minmax(0,1fr)]">
      <aside class="hidden lg:block" aria-label="On this page">
        {
          toc.length > 2 && (
            <nav aria-label="Table of contents" class="sticky top-24 text-sm">
              <p class="cur-eyebrow mb-3">On this page</p>
              <ul class="space-y-2 border-l border-border">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-3 text-muted-foreground hover:border-primary hover:text-foreground">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>

      <div class="min-w-0">
        <PostBody>
          <Content />
        </PostBody>
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-sm text-muted-foreground">
          <p>
            {post.updated ? <>Last updated <time datetime={isoDate(post.updated)}>{formatDate(post.updated)}</time></> : <>Published <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time></>}
          </p>
          <a href={editUrl} class="inline-flex items-center gap-1.5 font-medium text-[var(--link)] hover:underline">
            <Pencil className="size-4" aria-hidden="true" /> Suggest an edit on GitHub
          </a>
        </div>
      </div>

      <aside class="lg:pt-1" aria-label="Containers in this post">
        {
          images.length > 0 && (
            <section class="cur-card p-4 lg:sticky lg:top-24" aria-labelledby="containers">
              <h2 id="containers" class="cur-eyebrow mb-3">
                Containers in this post
              </h2>
              <ul class="space-y-1">
                {images.map((i) => (
                  <li class="group relative flex items-center gap-3 rounded-md p-2 hover:bg-muted">
                    <ImageLogo image={i} size={32} class="size-8 shrink-0 rounded" />
                    <div class="min-w-0">
                      <a href={withBase(i.url)} class="cur-stretch block truncate font-heading font-semibold outline-none group-focus-within:underline">
                        {i.name}
                      </a>
                      <p class="truncate text-xs text-muted-foreground">{i.categories[0] ?? 'Image'}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </article>

  <nav aria-label="More posts" class="cur-container mt-16">
    <div class="mx-auto grid grid-cols-[minmax(0,1fr)] max-w-5xl gap-4 sm:grid-cols-2">
      {
        older ? (
          <a href={older.url} class="cur-card cur-hover group flex items-center gap-4 p-5">
            <ArrowLeft className="size-5 shrink-0 text-muted-foreground transition group-hover:-translate-x-0.5 group-hover:text-primary" aria-hidden="true" />
            <span class="min-w-0">
              <span class="cur-eyebrow block">Older post</span>
              <span class="mt-1 block font-heading font-semibold">{older.title}</span>
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={newer.url} class="cur-card cur-hover group flex items-center justify-end gap-4 p-5 text-right sm:col-start-2">
            <span class="min-w-0">
              <span class="cur-eyebrow block">Newer post</span>
              <span class="mt-1 block font-heading font-semibold">{newer.title}</span>
            </span>
            <ArrowRight className="size-5 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-primary" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </nav>

  {
    related.length > 0 && (
      <section class="cur-container mt-20" aria-labelledby="related">
        <h2 id="related" class="mb-6 font-heading text-2xl font-semibold">
          Keep reading
        </h2>
        <ul class="grid grid-cols-[minmax(0,1fr)] gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
