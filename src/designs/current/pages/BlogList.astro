---
import type { BlogListProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { tagUrl } from '@/lib/posts';
import { Rss } from 'lucide-react';
import Layout from '../Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';

type Props = BlogListProps;
const { kind, heading, description, page, topTags, tag, author } = Astro.props;

const magazine = kind === 'all' && page.currentPage === 1;
const [lead, ...rest] = magazine ? page.data : [undefined, ...page.data];
const title = kind === 'tag' ? `Posts tagged “${heading}”` : kind === 'author' ? `Posts by ${heading}` : page.currentPage > 1 ? `Blog, page ${page.currentPage}` : 'Blog';
const crumbs =
  kind === 'tag'
    ? [{ name: 'Blog', href: '/blog/' }, { name: 'Topics', href: '/blog/tags/' }]
    : kind === 'author'
      ? [{ name: 'Blog', href: '/blog/' }]
      : page.currentPage > 1
        ? [{ name: 'Blog', href: '/blog/' }]
        : [];
const here = kind === 'tag' ? heading : kind === 'author' ? heading : page.currentPage > 1 ? `Page ${page.currentPage}` : 'Blog';
---

<Layout
  title={title}
  section="blog"
  description={description}
  breadcrumbs={[...crumbs, { name: here, href: Astro.url.pathname.replace(withBase('/'), '/') }]}
>
  <div class="cur-container pt-10">
    <Breadcrumbs items={crumbs} current={here} />
    <div class="mt-5 flex flex-wrap items-end justify-between gap-6 border-b border-border pb-8">
      <div class="max-w-2xl">
        {kind === 'tag' && <p class="cur-eyebrow mb-2">Topic</p>}
        {kind === 'author' && <p class="cur-eyebrow mb-2">Author{author?.role === 'alumni' ? ' · team alumnus' : author?.role === 'guest' ? ' · guest writer' : ''}</p>}
        <h1 class="font-heading text-4xl font-semibold tracking-tight md:text-5xl">{kind === 'all' ? 'News, guides & release notes' : heading}</h1>
        <p class="mt-3 text-lg text-muted-foreground">
          {
            kind === 'all'
              ? `${page.total} posts from the LinuxServer.io team, from 2013 to today.${page.currentPage > 1 ? ` Page ${page.currentPage} of ${page.lastPage}.` : ''}`
              : kind === 'tag'
                ? `${page.total} post${page.total === 1 ? '' : 's'} on this topic.`
                : (author?.bio ?? `${page.total} post${page.total === 1 ? '' : 's'} on the LinuxServer.io blog.`)
          }
        </p>
        {
          author?.github && (
            <p class="mt-3 text-sm">
              <a href={`https://github.com/${author.github}`} class="cur-link">
                github.com/{author.github}
              </a>
            </p>
          )
        }
      </div>
      <a href={withBase('/blog/rss.xml')} class="inline-flex h-10 items-center gap-2 rounded-md border border-border px-3.5 text-sm font-medium hover:bg-muted">
        <Rss className="size-4 text-primary" aria-hidden="true" /> RSS feed
      </a>
    </div>

    <nav aria-label="Topics" class="mt-5">
      <ul class="flex flex-wrap gap-2">
        <li>
          <a
            href={withBase('/blog/')}
            aria-current={kind === 'all' ? 'page' : undefined}
            class="inline-flex h-8 items-center rounded-full border border-border px-3 text-sm font-medium hover:bg-muted aria-[current=page]:border-foreground aria-[current=page]:bg-foreground aria-[current=page]:text-background"
            >All posts</a
          >
        </li>
        {
          topTags.map((t) => (
            <li>
              <a
                href={tagUrl(t.slug)}
                aria-current={tag?.slug === t.slug ? 'page' : undefined}
                class="inline-flex h-8 items-center gap-1.5 rounded-full border border-border px-3 text-sm hover:bg-muted aria-[current=page]:border-foreground aria-[current=page]:bg-foreground aria-[current=page]:text-background"
              >
                {t.name}
                <span class="text-xs tabular">{t.count}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('/blog/tags/')} class="inline-flex h-8 items-center px-2 text-sm font-medium text-[var(--link)] hover:underline">All topics →</a>
        </li>
      </ul>
    </nav>

    {lead && <div class="mt-10"><PostCard post={lead} size="lg" headingLevel="h2" eager /></div>}

    <ul class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.filter(Boolean).map((p) => (
          <li>
            <PostCard post={p!} headingLevel="h2" />
          </li>
        ))
      }
    </ul>

    <Pagination page={page} />
  </div>
</Layout>
