---
/** Chart-style ranked list: position, logo, name, category and a value with a thin proportional bar. */
import ImageLogo from '@/components/shared/ImageLogo.astro';
import { withBase } from '@/lib/base';
import { compact } from '@/lib/format';
import type { Image } from '@/lib/images';

interface Props {
  images: Image[];
  metric: 'stars' | 'monthly_pulls';
  unit: string;
}
const { images, metric, unit } = Astro.props;
const max = Math.max(...images.map((i) => i[metric]));
---

<ol class="divide-y divide-border">
  {
    images.map((i, n) => (
      <li class="group relative flex items-center gap-3 py-3">
        <span class="w-6 shrink-0 text-right font-heading text-lg font-semibold text-muted-foreground tabular" aria-hidden="true">
          {n + 1}
        </span>
        <ImageLogo image={i} size={36} class="size-9 shrink-0 rounded-md" />
        <div class="min-w-0 flex-1">
          <a href={withBase(i.url)} class="cur-stretch block truncate font-heading font-semibold outline-none group-hover:text-primary group-focus-within:underline">
            <span class="sr-only">Number {n + 1}: </span>
            {i.name}
          </a>
          <div class="mt-1.5 h-1 rounded-full bg-muted" aria-hidden="true">
            <div class="h-1 rounded-full bg-[var(--cur-bar)]" style={`width:${Math.max(4, (i[metric] / max) * 100)}%`} />
          </div>
        </div>
        <span class="w-20 shrink-0 text-right text-sm tabular">
          <span class="font-semibold">{compact(i[metric])}</span>
          <span class="text-muted-foreground"> {unit}</span>
        </span>
      </li>
    ))
  }
</ol>
