---
/**
 * Headline numbers as a ruled strip: big tabular value, plain label, and the source revealed on hover/focus
 * (and always present for screen readers via the <abbr>-free description).
 */
import type { Stat } from '@/lib/stats';
import { uid } from '@/lib/uid';
import { Info } from 'lucide-react';

interface Props {
  stats: Stat[];
  class?: string;
  label?: string;
}
const { stats, class: className, label = 'LinuxServer.io in numbers' } = Astro.props;
const id = uid('st');
---

<section aria-labelledby={id} class:list={['overflow-hidden rounded-xl border border-border bg-card', className]}>
  <h2 id={id} class="sr-only">{label}</h2>
  <dl class="grid grid-cols-2 divide-border sm:grid-cols-3 lg:grid-cols-6 [&>*]:border-border [&>*]:border-b sm:[&>*]:border-r">
    {
      stats.map((s) => (
        <div class="group relative flex flex-col px-5 py-5 lg:py-6" tabindex="0" aria-describedby={`${id}-${s.id}`}>
          <dt class="flex items-center gap-1 text-sm text-muted-foreground">
            {s.label}
            <Info className="size-3.5 opacity-60" aria-hidden="true" />
            <span
              id={`${id}-${s.id}`}
              role="tooltip"
              class="pointer-events-none absolute inset-x-3 bottom-[calc(100%-0.5rem)] z-10 rounded-md border border-border bg-popover px-3 py-2 text-xs leading-snug text-popover-foreground opacity-0 shadow-lg transition group-hover:opacity-100 group-focus:opacity-100"
            >
              <span class="font-medium">{s.long}.</span> Source: {s.source}
            </span>
          </dt>
          <dd class="order-first font-heading text-3xl font-semibold tracking-tight md:text-[2.25rem]">
            {s.value}
            {s.suffix && <span class="text-primary">{s.suffix}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
