---
import { ArrowRight } from 'lucide-react';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  link?: { label: string; href: string };
}
const { id, eyebrow, title, description, link } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div class="max-w-2xl">
    {eyebrow && <p class="cur-eyebrow mb-1.5">{eyebrow}</p>}
    <h2 id={id} class="font-heading text-2xl font-semibold md:text-[1.75rem]">{title}</h2>
    {description && <p class="mt-1.5 text-muted-foreground">{description}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="group inline-flex items-center gap-1 font-heading text-sm font-semibold text-primary">
        {link.label}
        <ArrowRight className="size-4 transition group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    )
  }
</div>
