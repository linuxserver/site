---
import type { Page } from '@/lib/posts';
import { ChevronLeft, ChevronRight } from 'lucide-react';

interface Props {
  page: Page<unknown>;
}
const { page } = Astro.props;
const { currentPage: cur, lastPage: last } = page;
const nums: (number | '…')[] = [];
for (let n = 1; n <= last; n++) {
  if (n === 1 || n === last || Math.abs(n - cur) <= 1) nums.push(n);
  else if (nums[nums.length - 1] !== '…') nums.push('…');
}
const btn = 'inline-flex h-10 min-w-10 items-center justify-center gap-1 rounded-md border border-border px-3 text-sm font-medium tabular transition hover:bg-muted';
---

{
  last > 1 && (
    <nav aria-label="Pagination" class="mt-14 flex flex-wrap items-center justify-center gap-2">
      {cur > 1 ? (
        <a href={page.url(cur - 1)} rel="prev" class={btn}>
          <ChevronLeft className="size-4" aria-hidden="true" /> Newer
        </a>
      ) : null}
      <ol class="flex flex-wrap items-center gap-1.5">
        {nums.map((n) =>
          n === '…' ? (
            <li class="px-1 text-muted-foreground" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              <a
                href={page.url(n)}
                aria-current={n === cur ? 'page' : undefined}
                aria-label={`Page ${n}`}
                class:list={[btn, n === cur && 'border-foreground bg-foreground text-background hover:bg-foreground']}
              >
                {n}
              </a>
            </li>
          ),
        )}
      </ol>
      {cur < last ? (
        <a href={page.url(cur + 1)} rel="next" class={btn}>
          Older <ChevronRight className="size-4" aria-hidden="true" />
        </a>
      ) : null}
    </nav>
  )
}
