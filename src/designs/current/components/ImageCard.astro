---
/** Catalogue card: logo, name, two-line summary, categories, monthly pulls, stars, arm64. Whole card is clickable. */
import ImageLogo from '@/components/shared/ImageLogo.astro';
import { withBase } from '@/lib/base';
import { compact } from '@/lib/format';
import type { Image } from '@/lib/images';
import { ArrowDownToLine, Cpu, Star } from 'lucide-react';

interface Props {
  image: Image;
  headingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}
const { image, headingLevel: H = 'h3', class: className } = Astro.props;
---

<article class:list={['cur-card cur-hover group relative flex flex-col p-4', className]}>
  <div class="flex items-start gap-3">
    <ImageLogo image={image} size={44} class="size-11 shrink-0 rounded-lg" />
    <div class="min-w-0 flex-1">
      <H class="truncate font-heading text-base font-semibold">
        <a href={withBase(image.url)} class="cur-stretch outline-none group-focus-within:underline">{image.name}</a>
      </H>
      <p class="truncate text-xs text-muted-foreground">{image.categories.slice(0, 2).join(' · ') || 'Uncategorised'}</p>
    </div>
  </div>
  <p class="cur-clamp-2 mt-3 text-sm leading-relaxed text-muted-foreground">{image.summary}</p>
  <dl class="mt-auto flex items-center gap-4 pt-4 text-xs text-muted-foreground tabular">
    <div class="flex items-center gap-1" title="Pulls in the last month">
      <dt><ArrowDownToLine className="size-3.5" aria-hidden="true" /><span class="sr-only">Monthly pulls</span></dt>
      <dd>{compact(image.monthly_pulls)}/mo</dd>
    </div>
    <div class="flex items-center gap-1">
      <dt><Star className="size-3.5" aria-hidden="true" /><span class="sr-only">GitHub stars</span></dt>
      <dd>{compact(image.stars)}</dd>
    </div>
    {
      image.arm64 && (
        <div class="ml-auto flex items-center gap-1 rounded border border-border px-1.5 py-0.5 font-mono text-[0.6875rem]">
          <dt class="sr-only">Architectures</dt>
          <dd class="flex items-center gap-1">
            <Cpu className="size-3" aria-hidden="true" />
            arm64
          </dd>
        </div>
      )
    }
  </dl>
</article>
