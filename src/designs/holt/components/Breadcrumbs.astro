---
import type { Crumb } from '@/designs/types';
import { withBase } from '@/lib/base';
interface Props {
  crumbs: Crumb[];
  class?: string;
}
const { crumbs, class: className } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...crumbs];
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true" class="opacity-50">/</span>}
          {i === all.length - 1 ? (
            <span aria-current="page" class="font-medium text-foreground">{c.name}</span>
          ) : (
            <a href={withBase(c.href)} class="underline-offset-4 hover:text-foreground hover:underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
