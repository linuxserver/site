---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  action?: { label: string; href: string };
  id?: string;
  level?: 'h2' | 'h3';
  align?: 'left' | 'center';
}
const { eyebrow, title, description, action, id, level: H = 'h2', align = 'left' } = Astro.props;
---

<div class:list={['flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between', align === 'center' && 'items-center text-center sm:flex-col sm:items-center']}>
  <div class:list={['max-w-2xl', align === 'center' && 'mx-auto']}>
    {eyebrow && <p class="mb-2 text-sm font-semibold tracking-wide text-primary">{eyebrow}</p>}
    <H id={id} class="font-heading text-3xl font-bold tracking-tight text-foreground md:text-[2.5rem] md:leading-[1.1]">{title}</H>
    {description && <p class="mt-3 text-lg text-muted-foreground">{description}</p>}
  </div>
  {
    action && (
      <a href={action.href} class="group inline-flex shrink-0 items-center gap-1.5 rounded-full px-1 font-semibold text-[var(--link)] hover:underline underline-offset-4">
        {action.label}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    )
  }
</div>
