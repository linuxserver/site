---
import './theme.css';
import BaseHead from '@/components/shared/BaseHead.astro';
import Icon from '@/components/shared/Icon.astro';
import Logo from '@/components/shared/Logo.astro';
import Otter from '@/components/shared/Otter.astro';
import ReviewBar from '@/components/shared/ReviewBar.astro';
import CommandSearch from '@/components/islands/CommandSearch';
import MobileNav from '@/components/islands/MobileNav';
import ThemeToggle from '@/components/islands/ThemeToggle';
import type { LayoutProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { DONATE_URL, LINKS, NAV, NAV_SECONDARY, SOCIAL } from '@/lib/site';
import { ArrowUpRight, Heart } from 'lucide-react';

type Props = LayoutProps;
const { section = 'none', ...seo } = Astro.props;

const href = (h: string) => (h.startsWith('/') ? withBase(h) : h);
const isCurrent = (h: string) => h.startsWith('/') && section !== 'none' && h.startsWith(`/${section}`);
const year = new Date().getUTCFullYear();

const footerCols = [
  {
    title: 'Images',
    links: [
      { label: 'All images', href: '/images/' },
      { label: 'Most popular', href: '/images/?sort=popular' },
      { label: 'Recently added', href: '/images/?sort=newest' },
      { label: 'Fleet info', href: LINKS.info, external: true },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Documentation', href: LINKS.docs, external: true },
      { label: 'Blog', href: '/blog/' },
      { label: 'Topics', href: '/blog/tags/' },
      { label: 'Search', href: '/search/' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Get support', href: '/support/' },
      { label: 'Discord', href: LINKS.discord, external: true },
      { label: 'Discussions', href: LINKS.discussions, external: true },
      { label: 'Service status', href: LINKS.status, external: true },
    ],
  },
  {
    title: 'LinuxServer.io',
    links: [
      { label: 'About us', href: '/about/' },
      { label: 'The team', href: '/about/#team' },
      { label: 'Donate', href: '/donate/' },
      { label: 'GitHub', href: LINKS.github, external: true },
    ],
  },
];
---

<!doctype html>
<html lang="en-GB" data-design="holt">
  <head>
    <BaseHead {...seo} defaultTheme="system" themeColor={{ light: '#fdfaf7', dark: '#150e20' }} />
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-transparent bg-background/80 backdrop-blur-xl supports-[backdrop-filter]:bg-background/70 [&.scrolled]:border-border" data-holt-header>
      <div class="holt-container flex h-16 items-center gap-4 md:h-[4.5rem]">
        <a href={withBase('/')} class="flex shrink-0 items-center rounded-lg text-foreground" aria-label="LinuxServer.io home">
          <Logo variant="full" class="h-7 w-auto md:h-8" title="" />
        </a>

        <nav aria-label="Main" class="ml-6 hidden lg:block">
          <ul class="flex items-center gap-1">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={href(item.href)}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                    class="inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-[0.9375rem] font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground"
                  >
                    {item.label}
                    {item.external && (
                      <>
                        <ArrowUpRight className="size-3.5 opacity-60" aria-hidden="true" />
                        <span class="sr-only">(opens in a new tab)</span>
                      </>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
          <CommandSearch
            client:idle
            indexUrl={withBase('/search-index.json')}
            searchUrl={withBase('/search/')}
            trigger="input"
            placeholder="Search…"
            className="hidden w-52 rounded-full md:inline-flex xl:w-64"
          />
          <CommandSearch client:idle indexUrl={withBase('/search-index.json')} searchUrl={withBase('/search/')} trigger="icon" className="md:hidden" />
          <ThemeToggle client:idle className="rounded-full" />
          <a
            href={withBase('/donate/')}
            class="hidden items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition hover:brightness-110 sm:inline-flex"
          >
            <Heart className="size-4" aria-hidden="true" /> Donate
          </a>
          <MobileNav
            client:idle
            className="rounded-full lg:hidden"
            items={NAV.map((n) => ({ ...n, href: href(n.href), current: isCurrent(n.href) }))}
            secondary={[...NAV_SECONDARY, { label: 'Donate', href: withBase('/donate/') }]}
            cta={{ label: 'Support us on Open Collective', href: DONATE_URL }}
          />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <footer class="relative mt-24 bg-[var(--holt-band)] text-[var(--holt-band-foreground)]">
      <div class="pointer-events-none absolute -top-[4.2rem] left-[8%] w-28 md:left-[12%] md:w-32">
        <Otter pose="peek" class="w-full" />
      </div>
      <div class="holt-container grid gap-12 pt-20 pb-10 md:grid-cols-[1.2fr_2fr]">
        <div>
          <Logo variant="full" class="h-8 w-auto text-white" title="LinuxServer.io" />
          <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-white/80">
            A group of volunteers from around the world building and maintaining the largest collection of community Docker images. Free and open source,
            always.
          </p>
          <ul class="mt-6 flex gap-2" aria-label="LinuxServer.io elsewhere">
            {
              SOCIAL.map((s) => (
                <li>
                  <a
                    href={href(s.href)}
                    class="grid size-10 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
                    aria-label={s.name}
                    {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener me' } : {})}
                  >
                    <Icon name={s.icon === 'docs' ? 'github' : s.icon} class="size-[1.15rem]" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
          {
            footerCols.map((col) => (
              <div>
                <h2 class="font-heading text-sm font-semibold tracking-wide text-white">{col.title}</h2>
                <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
                  {col.links.map((l) => (
                    <li>
                      <a
                        href={href(l.href)}
                        class="text-white/75 underline-offset-4 transition hover:text-white hover:underline"
                        {...('external' in l && l.external ? { target: '_blank', rel: 'noopener' } : {})}
                      >
                        {l.label}
                        {'external' in l && l.external && <span class="sr-only"> (opens in a new tab)</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="holt-container flex flex-col items-start justify-between gap-4 border-t border-white/10 py-6 text-sm text-white/75 sm:flex-row sm:items-center">
        <p>© {year} LinuxServer.io</p>
        <p class="flex items-center gap-2">
          Infrastructure kindly supported by
          <a href="https://www.digitalocean.com/" target="_blank" rel="noopener" class="font-semibold text-white underline-offset-4 hover:underline">DigitalOcean</a>
        </p>
      </div>
    </footer>

    <ReviewBar />

    <script>
      const header = document.querySelector('[data-holt-header]');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
