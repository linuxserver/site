---
import Layout from '../Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ImageCard from '../components/ImageCard.astro';
import ImageLogo from '@/components/shared/ImageLogo.astro';
import Otter from '@/components/shared/Otter.astro';
import CopyButton from '@/components/islands/CopyButton';
import QuickStart from '@/components/islands/QuickStart';
import type { ImageProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { compact, formatDate, grouped, isoDate, relative } from '@/lib/format';
import { imageJsonLd } from '@/lib/jsonld';
import { SITE } from '@/lib/site';
import { AlertTriangle, ArrowUpRight, BookOpen, Check, Cpu, Download, ExternalLink, Minus, Star } from 'lucide-react';

type Props = ImageProps;
const { image, related, posts, snippets, snapshotDate } = Astro.props;
const c = image.config ?? {};
const pull = `docker pull ${SITE.registry}/${image.name}:latest`;
const built = image.version_timestamp.replace(' ', 'T');

const facts = [
  { label: 'Pulls this month', value: compact(image.monthly_pulls), icon: Download },
  { label: 'Docker Hub pulls', value: image.hubPulls ? compact(image.hubPulls) : 'n/a', icon: Download },
  { label: 'GitHub stars', value: compact(image.stars), icon: Star },
  { label: 'Architectures', value: image.architectures.map((a) => (a.arch === 'x86_64' ? 'x86-64' : a.arch)).join(', '), icon: Cpu, small: true },
];

const tables = [
  { id: 'env', title: 'Environment variables', cols: ['Variable', 'Default', 'What it does'], rows: (c.env_vars ?? []).map((e) => ({ k: e.name, v: e.value, d: e.desc, o: e.optional })) },
  { id: 'volumes', title: 'Volumes', cols: ['Path in container', 'Example host path', 'What it holds'], rows: (c.volumes ?? []).map((v) => ({ k: v.path, v: v.host_path, d: v.desc, o: v.optional })) },
  { id: 'ports', title: 'Ports', cols: ['Container', 'Host', 'What it is for'], rows: (c.ports ?? []).map((p) => ({ k: p.internal, v: p.external, d: p.desc, o: p.optional })) },
  { id: 'devices', title: 'Devices', cols: ['Device', 'Host device', 'Why'], rows: (c.devices ?? []).map((d) => ({ k: d.path, v: d.host_path, d: d.desc, o: d.optional })) },
].filter((t) => t.rows.length);

const support = [
  { label: 'Read-only container', ok: !!c.readonly_supported },
  { label: 'Runs as non-root', ok: !!c.nonroot_supported },
  { label: 'arm64', ok: image.arm64 },
];
---

<Layout
  section="images"
  title={`${image.name} Docker image`}
  description={`${image.summary.slice(0, 150)}${image.summary.length > 150 ? '…' : ''} Run it with Docker Compose in minutes: ${SITE.registry}/${image.name}.`}
  breadcrumbs={[
    { name: 'Images', href: '/images/' },
    { name: image.name, href: image.url },
  ]}
  jsonLd={[imageJsonLd(image, Astro.site)]}
>
  <section class="holt-glow border-b border-border/60">
    <div class="holt-container pt-8 pb-12 md:pb-16">
      <Breadcrumbs crumbs={[{ name: 'Images', href: '/images/' }, { name: image.name, href: image.url }]} />
      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div class="grid size-24 shrink-0 place-items-center rounded-[1.75rem] bg-card holt-tile p-4 shadow-[var(--holt-shadow-lg)] md:size-28">
            <ImageLogo image={image} size={80} class="size-full" loading="eager" />
          </div>
          <div class="min-w-0">
            <p class="flex flex-wrap gap-2 text-sm">
              {image.categories.map((cat) => (
                <a href={withBase(`/images/?category=${encodeURIComponent(cat)}`)} class="rounded-full bg-card px-3 py-1 font-medium text-foreground shadow-sm hover:text-primary">{cat}</a>
              ))}
            </p>
            <h1 class="mt-3 font-heading text-5xl font-extrabold tracking-tight break-words text-foreground md:text-6xl">{image.name}</h1>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">{image.summary}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={image.docsUrl} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-full bg-primary px-5 font-semibold text-primary-foreground transition hover:brightness-110">
                <BookOpen className="size-4" aria-hidden="true" /> Setup guide<span class="sr-only"> (opens in a new tab)</span>
              </a>
              <a href={image.github_url} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-full border border-border bg-card px-5 font-semibold text-foreground transition hover:bg-muted">
                Source on GitHub <ArrowUpRight className="size-4" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span>
              </a>
              {image.project_url && (
                <a href={image.project_url} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-full px-3 font-semibold text-[var(--link)] hover:underline">
                  Project website <ExternalLink className="size-4" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </div>
        </div>
        <div class="holt-card p-5">
          <p class="text-sm font-semibold text-foreground">Latest version</p>
          <p class="mt-1 font-mono text-lg break-all text-foreground">{image.version}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Built <time datetime={built}>{relative(built, snapshotDate)}</time>
            {image.initial_date && <> · first built <time datetime={image.initial_date}>{formatDate(image.initial_date)}</time></>}
          </p>
          <div class="mt-4 flex items-center gap-2 rounded-xl bg-muted py-1.5 pr-1.5 pl-3">
            <code class="min-w-0 flex-1 truncate font-mono text-[0.8125rem] text-foreground">{pull}</code>
            <CopyButton client:visible text={pull} label="Copy docker pull command" variant="ghost" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    image.deprecated && (
      <div class="holt-container pt-8">
        <div role="note" class="flex gap-4 rounded-2xl border border-[var(--destructive)]/30 bg-[var(--destructive)]/8 p-5 text-foreground">
          <AlertTriangle className="mt-0.5 size-5 shrink-0 text-[var(--destructive)]" aria-hidden="true" />
          <div>
            <p class="font-semibold">This image is deprecated</p>
            <p class="mt-1 text-muted-foreground">
              It no longer receives updates. Check the changelog and the GitHub repository for the recommended replacement before setting up something new.
            </p>
          </div>
        </div>
      </div>
    )
  }

  <div class="holt-container grid gap-12 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="min-w-0 space-y-14" data-pagefind-body>
      <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {
          facts.map((f) => (
            <div class="holt-card p-4">
              <dt class="flex items-center gap-1.5 text-sm text-muted-foreground">
                <f.icon className="size-4 text-primary" aria-hidden="true" /> {f.label}
              </dt>
              <dd class:list={['mt-1 font-heading font-bold text-foreground tabular-nums', 'small' in f ? 'pt-1 text-lg leading-snug' : 'text-2xl']}>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        image.config && (
          <section aria-labelledby="quick-start">
            <h2 id="quick-start" class="font-heading text-3xl font-bold tracking-tight text-foreground">Quick start</h2>
            <p class="mt-2 text-muted-foreground">
              Paste this into a <code class="rounded bg-muted px-1.5 py-0.5 text-[0.875em]">compose.yaml</code>, change the paths to suit, and run{' '}
              <code class="rounded bg-muted px-1.5 py-0.5 text-[0.875em]">docker compose up -d</code>.
            </p>
            <div class="holt-card mt-6 overflow-hidden">
              <QuickStart client:visible name={image.name} {...snippets} preClassName="bg-[#1d1330] text-[#f6efff] min-h-40" />
            </div>
            {c.application_setup && (
              <p class="mt-4 text-sm text-muted-foreground">
                Next: follow the{' '}
                <a href={c.application_setup} target="_blank" rel="noopener" class="font-semibold text-[var(--link)] underline underline-offset-4">
                  application setup notes<span class="sr-only"> (opens in a new tab)</span>
                </a>{' '}
                for first-run steps.
              </p>
            )}
          </section>
        )
      }

      {
        tables.length > 0 && (
          <section aria-labelledby="parameters" class="space-y-8">
            <h2 id="parameters" class="font-heading text-3xl font-bold tracking-tight text-foreground">Parameters</h2>
            {tables.map((t) => (
              <div>
                <h3 class="mb-3 font-heading text-xl font-bold text-foreground">{t.title}</h3>
                <div class="holt-card overflow-x-auto">
                  <table class="w-full min-w-[36rem] text-left text-sm">
                    <thead class="border-b border-border bg-muted/60 text-foreground">
                      <tr>
                        {t.cols.map((col) => (
                          <th scope="col" class="px-4 py-3 font-semibold">{col}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                      {t.rows.map((r) => (
                        <tr class="align-top">
                          <th scope="row" class="px-4 py-3 font-mono text-[0.8125rem] font-semibold whitespace-nowrap text-foreground">{r.k}</th>
                          <td class="px-4 py-3 font-mono text-[0.8125rem] break-all text-muted-foreground">{r.v}</td>
                          <td class="px-4 py-3 text-muted-foreground">
                            {r.d}
                            {r.o && <span class="ml-2 rounded-full bg-secondary px-2 py-0.5 text-xs font-semibold text-secondary-foreground">optional</span>}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </section>
        )
      }

      <section aria-labelledby="tags">
        <h2 id="tags" class="font-heading text-3xl font-bold tracking-tight text-foreground">Tags</h2>
        <p class="mt-2 text-muted-foreground">Use <code class="rounded bg-muted px-1.5 py-0.5 text-[0.875em]">latest</code> unless you need one of these.</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            image.tags.map((t) => (
              <li class="holt-card flex flex-col gap-1 p-4">
                <code class="font-mono text-sm font-semibold text-foreground">{image.name}:{t.tag}</code>
                <span class="text-sm text-muted-foreground">{t.desc}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        image.changelog && image.changelog.length > 0 && (
          <section aria-labelledby="changes">
            <h2 id="changes" class="font-heading text-3xl font-bold tracking-tight text-foreground">Recent changes</h2>
            <ol class="mt-6 space-y-0 border-l-2 border-border pl-6">
              {image.changelog.slice(0, 8).map((ch) => (
                <li class="relative pb-6 last:pb-0">
                  <span class="absolute top-1.5 -left-[1.95rem] size-3 rounded-full border-2 border-background bg-primary" aria-hidden="true" />
                  <time datetime={ch.date} class="text-sm font-semibold text-foreground">{formatDate(ch.date)}</time>
                  <p class="mt-1 text-muted-foreground">{ch.desc}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start" aria-label={`About ${image.name}`}>
      <div class="holt-card p-6">
        <h2 class="font-heading text-lg font-bold text-foreground">At a glance</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            support.map((x) => (
              <li class="flex items-center gap-2.5">
                <span class:list={['grid size-6 place-items-center rounded-full', x.ok ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground']}>
                  {x.ok ? <Check className="size-3.5" aria-hidden="true" /> : <Minus className="size-3.5" aria-hidden="true" />}
                </span>
                <span class="text-foreground">{x.label}</span>
                <span class="sr-only">{x.ok ? 'supported' : 'not supported'}</span>
              </li>
            ))
          }
        </ul>
        <dl class="mt-5 space-y-2 border-t border-border pt-5 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Registry</dt><dd class="font-mono text-foreground">lscr.io</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Tags</dt><dd class="text-foreground">{grouped(image.tags.length)}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Last build</dt><dd class="text-foreground"><time datetime={built}>{formatDate(built)}</time></dd></div>
        </dl>
      </div>

      {
        posts.length > 0 && (
          <div class="holt-card p-6">
            <h2 class="font-heading text-lg font-bold text-foreground">On the blog</h2>
            <ul class="mt-3 space-y-3">
              {posts.map((p) => (
                <li>
                  <a href={p.url} class="font-semibold text-foreground underline-offset-4 hover:text-primary hover:underline">{p.title}</a>
                  <p class="text-sm text-muted-foreground"><time datetime={isoDate(p.date)}>{formatDate(p.date)}</time></p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="holt-card relative mt-16 p-6">
        <div class="pointer-events-none absolute -top-[3.4rem] right-6 w-24" aria-hidden="true"><Otter pose="peek" class="w-full" /></div>
        <h2 class="font-heading text-lg font-bold text-foreground">Stuck?</h2>
        <p class="mt-2 text-sm text-muted-foreground">Check the setup guide first, then ask on Discord or our forum. Someone will help.</p>
        <a href={withBase('/support/')} class="mt-4 inline-flex font-semibold text-[var(--link)] underline-offset-4 hover:underline">Get support →</a>
      </div>
    </aside>
  </div>

  {
    related.length > 0 && (
      <section aria-labelledby="related" class="holt-container pb-8">
        <h2 id="related" class="font-heading text-3xl font-bold tracking-tight text-foreground">You might also like</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => <ImageCard image={r} />)}
        </div>
      </section>
    )
  }
</Layout>
