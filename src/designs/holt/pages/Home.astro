---
import Layout from '../Layout.astro';
import ImageCard from '../components/ImageCard.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImageLogo from '@/components/shared/ImageLogo.astro';
import Otter from '@/components/shared/Otter.astro';
import CommandSearch from '@/components/islands/CommandSearch';
import type { HomeProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { compact, formatDate, isoDate, relative } from '@/lib/format';
import { DONATE_URL, PILLARS } from '@/lib/site';
import { SINCE_YEAR } from '@/lib/stats';
import { ArrowRight, BookOpen, Download, Heart, Layers, LifeBuoy, MessagesSquare, RefreshCw, Star } from 'lucide-react';

type Props = HomeProps;
const { stats, spotlight, mostStarred, mostPulled, posts, categories, snapshotDate } = Astro.props;
const s = spotlight.image;
const weekNo = Number(spotlight.week.split('-W')[1]);
const orbit = mostPulled.slice(0, 5);
const pillarIcons = { standardised: Layers, updates: RefreshCw, docs: BookOpen, support: LifeBuoy } as const;
const pillarProof: Record<string, string> = {
  standardised: `${stats.arm64.value} of ${stats.images.value} images are built for both x86-64 and arm64.`,
  updates: `${stats.updatedThisWeek.value} images were rebuilt in the last seven days.`,
  docs: `Every one of our ${stats.images.value} images has a setup guide.`,
  support: `${stats.team.value} volunteers, plus a community that has been helping each other since ${SINCE_YEAR}.`,
};
const latest = posts.slice(0, 3);
const minor = [stats.monthlyPulls, stats.images, stats.stars, stats.backers];
---

<Layout section="home" description="LinuxServer.io builds and maintains the largest collection of community Docker images: standardised, regularly updated, documented and supported by volunteers.">
  <!-- Hero -->
  <section class="holt-glow relative overflow-hidden">
    <div class="holt-container grid items-center gap-12 pt-14 pb-20 md:pt-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:pb-28">
      <div>
        <a
          href={withBase(s.url)}
          class="group mb-7 inline-flex items-center gap-2 rounded-full border border-border bg-card/80 py-1 pr-3 pl-1 text-sm shadow-sm backdrop-blur transition hover:border-primary/40"
        >
          <span class="rounded-full bg-primary px-2.5 py-0.5 text-xs font-bold text-primary-foreground">Week {weekNo}</span>
          <span class="text-muted-foreground">Spotlight:</span>
          <span class="font-semibold text-foreground">{s.name}</span>
          <ArrowRight className="size-3.5 text-muted-foreground transition group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
        <h1 class="font-heading text-[2.75rem] leading-[1.02] font-extrabold tracking-tight text-foreground sm:text-6xl lg:text-7xl">
          Docker images, built by the <span class="holt-ink">community</span>, for everyone.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">
          We are volunteers from around the world maintaining the largest collection of community Docker images. Standardised, updated
          automatically, documented properly and supported by real people.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={withBase('/images/')}
            class="inline-flex h-12 items-center gap-2 rounded-full bg-primary px-6 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition hover:brightness-110"
          >
            Browse {stats.images.value} images <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a
            href="https://docs.linuxserver.io/"
            target="_blank"
            rel="noopener"
            class="inline-flex h-12 items-center gap-2 rounded-full border border-border bg-card px-6 text-base font-semibold text-foreground transition hover:bg-muted"
          >
            <BookOpen className="size-4" aria-hidden="true" /> Read the docs<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
        <div class="mt-8 max-w-md">
          <CommandSearch
            client:idle
            indexUrl={withBase('/search-index.json')}
            searchUrl={withBase('/search/')}
            trigger="input"
            placeholder="Find an image: plex, wireguard, code-server…"
            className="h-12 rounded-full bg-card px-5 text-base shadow-sm"
          />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-hidden="true">
        <div class="relative aspect-square">
          <div class="absolute inset-[8%] rounded-full bg-gradient-to-br from-[var(--holt-glow-1)] via-[var(--holt-glow-2)] to-[var(--holt-glow-3)] opacity-90"></div>
          <div class="absolute inset-[18%] rounded-full border border-dashed border-primary/25"></div>
          <Otter pose="float" class="absolute inset-x-[4%] top-[30%] w-[92%]" />
          {
            orbit.map((img, i) => {
              const pos = ['left-[6%] top-[14%]', 'right-[8%] top-[8%]', 'right-[0%] top-[48%]', 'left-[0%] top-[58%]', 'left-[38%] bottom-[2%]'][i];
              return (
                <div class={`holt-bob absolute ${pos} grid size-16 place-items-center rounded-2xl bg-card holt-tile p-3 shadow-[var(--holt-shadow-lg)] md:size-20`} style={`animation-delay:${i * -1.3}s`}>
                  <ImageLogo image={img} size={48} class="size-full" loading="eager" />
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Stats, told as a story -->
  <section aria-labelledby="userbase" class="relative">
    <div class="holt-container py-20 md:py-28">
      <p class="mb-3 text-sm font-semibold tracking-wide text-primary">A worldwide userbase</p>
      <h2 id="userbase" class="max-w-5xl font-heading text-3xl leading-[1.15] font-bold tracking-tight text-foreground md:text-5xl md:leading-[1.12]">
        Since <span class="text-primary">{SINCE_YEAR}</span>, a team of <span class="text-primary">{stats.team.value} volunteers</span> has built{' '}
        <span class="text-primary">{stats.images.value} images</span> that have been pulled <span class="holt-ink">{stats.hubPulls.value}{stats.hubPulls.suffix}</span> times
        from Docker Hub alone.
      </h2>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
        <figure class="holt-card relative overflow-hidden p-7 sm:col-span-2 lg:col-span-1 lg:row-span-2">
          <div class="absolute -right-10 -bottom-12 size-56 rounded-full bg-gradient-to-br from-otter-pink/25 to-otter-violet/25 blur-2xl" aria-hidden="true"></div>
          <p class="relative font-heading text-6xl font-extrabold tracking-tight text-foreground tabular-nums md:text-8xl">
            {stats.hubPulls.value}<span class="text-primary">{stats.hubPulls.suffix}</span>
          </p>
          <figcaption class="relative mt-3 text-lg font-medium text-foreground">
            {stats.hubPulls.label}
            <span class="mt-2 block text-sm font-normal text-muted-foreground">{stats.hubPulls.source}</span>
          </figcaption>
        </figure>
        {
          minor.map((st) => (
            <figure class="holt-card p-6">
              <p class="font-heading text-4xl font-extrabold tracking-tight text-foreground tabular-nums">
                {st.value}
                {'suffix' in st && st.suffix && <span class="text-primary">{st.suffix}</span>}
              </p>
              <figcaption class="mt-1.5 font-medium text-foreground">
                {st.label}
                <span class="mt-1 block text-xs font-normal text-muted-foreground">{st.source}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted-foreground">
        Figures as of <time datetime={isoDate(snapshotDate)}>{formatDate(snapshotDate)}</time>, refreshed with every build.
      </p>
    </div>
  </section>

  <!-- Weekly spotlight -->
  <section aria-labelledby="spotlight" class="holt-container pt-6 pb-20 md:pb-28">
    <SectionHeading eyebrow={`Week ${weekNo} spotlight`} title="Something new to try this week" id="spotlight" description="Each week we put one of our newest images in the spotlight. Here is this week’s." />
    <div class="mt-16 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <article class="holt-card relative p-7 md:p-10">
        <div class="pointer-events-none absolute -top-[3.9rem] right-10 w-28" aria-hidden="true">
          <Otter pose="peek" class="w-full" />
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <div class="grid size-20 place-items-center rounded-3xl bg-muted holt-tile p-3.5 md:size-24">
            <ImageLogo image={s} size={72} class="size-full" />
          </div>
          <div>
            <h3 class="font-heading text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">{s.name}</h3>
            <p class="mt-1 text-muted-foreground">
              {s.categories.join(' · ')}
              {s.initial_date && (
                <>
                  {' '}· added <time datetime={s.initial_date}>{formatDate(s.initial_date)}</time>
                </>
              )}
            </p>
          </div>
        </div>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground">{s.summary}</p>
        {
          spotlight.note && (
            <blockquote class="mt-6 rounded-2xl border-l-4 border-primary bg-accent/60 px-5 py-4 text-foreground">
              <p class="italic">“{spotlight.note}”</p>
              {spotlight.by && <footer class="mt-2 text-sm text-muted-foreground">{spotlight.by}</footer>}
            </blockquote>
          )
        }
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase(s.url)} class="inline-flex h-11 items-center gap-2 rounded-full bg-primary px-5 font-semibold text-primary-foreground transition hover:brightness-110">
            Set up {s.name} <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a href={s.docsUrl} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-full border border-border px-5 font-semibold text-foreground transition hover:bg-muted">
            Documentation<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </article>
      <aside class="holt-card p-6 md:p-7" aria-labelledby="also-new">
        <h3 id="also-new" class="font-heading text-xl font-bold text-foreground">Also new to the family</h3>
        <ul class="mt-4 divide-y divide-border">
          {
            spotlight.alsoNew.map((img) => (
              <li>
                <a href={withBase(img.url)} class="group flex items-center gap-3.5 py-3">
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-muted holt-tile p-2">
                    <ImageLogo image={img} size={28} class="size-7" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-foreground group-hover:text-primary">{img.name}</span>
                    <span class="block truncate text-sm text-muted-foreground">{img.summary}</span>
                  </span>
                  {img.initial_date && (
                    <time datetime={img.initial_date} class="shrink-0 text-xs text-muted-foreground">
                      {relative(img.initial_date, snapshotDate)}
                    </time>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- Favourites -->
  <section aria-labelledby="favourites" class="bg-muted/50 py-20 md:py-28">
    <div class="holt-container">
      <SectionHeading eyebrow="Community favourites" title="The images people love most" id="favourites" action={{ label: `All ${stats.images.value} images`, href: withBase('/images/') }} />
      <div class="mt-12 grid gap-12 lg:grid-cols-2 [&>*]:min-w-0">
        {
          [
            { title: 'Most starred on GitHub', icon: Star, list: mostStarred.slice(0, 6), metric: (i: (typeof mostStarred)[number]) => `${compact(i.stars)} stars` },
            { title: 'Most pulled this month', icon: Download, list: mostPulled.slice(0, 6), metric: (i: (typeof mostPulled)[number]) => `${compact(i.monthly_pulls)} pulls` },
          ].map((col) => (
            <div>
              <h3 class="flex items-center gap-2 font-heading text-xl font-bold text-foreground">
                <col.icon className="size-5 text-primary" aria-hidden="true" /> {col.title}
              </h3>
              <ol class="mt-5 space-y-3">
                {col.list.map((img, i) => (
                  <li>
                    <a href={withBase(img.url)} class="holt-card holt-lift group flex items-center gap-4 p-3.5 pr-5">
                      <span class="w-6 text-center font-heading text-lg font-bold text-muted-foreground tabular-nums">{i + 1}</span>
                      <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-muted holt-tile p-2">
                        <ImageLogo image={img} size={32} class="size-8" />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block font-semibold text-foreground group-hover:text-primary">{img.name}</span>
                        <span class="block truncate text-sm text-muted-foreground">{img.summary}</span>
                      </span>
                      <span class="shrink-0 text-sm font-semibold text-foreground tabular-nums">{col.metric(img)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>

      <div class="mt-16">
        <h3 class="font-heading text-xl font-bold text-foreground">Find something for…</h3>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            categories.slice(0, 18).map((c) => (
              <li>
                <a
                  href={withBase(`/images/?category=${encodeURIComponent(c.name)}`)}
                  class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition hover:border-primary/50 hover:text-primary"
                >
                  {c.name} <span class="text-muted-foreground tabular-nums">{c.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section aria-labelledby="why" class="holt-container py-20 md:py-28">
    <SectionHeading eyebrow="Why LinuxServer.io" title="Four promises we have kept for over a decade" id="why" />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        PILLARS.map((p, i) => {
          const IconC = pillarIcons[p.id];
          return (
            <article class="holt-card relative overflow-hidden p-7 md:p-8">
              <div class:list={['mb-5 grid size-12 place-items-center rounded-2xl text-white', ['bg-otter-magenta', 'bg-otter-violet', 'bg-otter-blue', 'bg-otter-plum'][i]]}>
                <IconC className="size-6" aria-hidden="true" />
              </div>
              <h3 class="font-heading text-2xl font-bold text-foreground">{p.title}</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{p.body}</p>
              <p class="mt-5 rounded-xl bg-muted px-4 py-3 text-sm font-medium text-foreground">{pillarProof[p.id]}</p>
              <a
                href={p.link.href.startsWith('/') ? withBase(p.link.href) : p.link.href}
                {...(p.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                class="mt-5 inline-flex items-center gap-1.5 font-semibold text-[var(--link)] underline-offset-4 hover:underline"
              >
                {p.link.label} <span aria-hidden="true">→</span>
                {p.link.href.startsWith('http') && <span class="sr-only">(opens in a new tab)</span>}
              </a>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- Blog -->
  <section aria-labelledby="blog" class="holt-container pb-20 md:pb-28">
    <SectionHeading eyebrow="From the blog" title="News, guides and deep dives" id="blog" action={{ label: 'All posts', href: withBase('/blog/') }} />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((p) => <PostCard post={p} />)}
    </div>
  </section>

  <!-- Volunteer CTA -->
  <section aria-labelledby="volunteers" class="holt-container">
    <div class="relative overflow-hidden rounded-[2rem] bg-[var(--holt-band)] px-7 py-12 text-[var(--holt-band-foreground)] md:px-14 md:py-16">
      <div class="absolute -top-24 -right-16 size-80 rounded-full bg-otter-magenta/30 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-28 left-1/3 size-80 rounded-full bg-otter-blue/25 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 md:grid-cols-[1.6fr_1fr]">
        <div>
          <h2 id="volunteers" class="font-heading text-3xl font-bold tracking-tight text-white md:text-5xl">Everyone here is a volunteer.</h2>
          <p class="mt-4 max-w-xl text-lg text-white/85">
            Nobody is paid to do this. {stats.backers.value} backers help cover the servers and build hardware. If our images save you time, consider
            joining them, or come and help others on Discord.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={DONATE_URL} class="inline-flex h-12 items-center gap-2 rounded-full bg-white px-6 font-semibold text-[#2a1740] transition hover:bg-white/90">
              <Heart className="size-4 text-otter-magenta" aria-hidden="true" /> Support us on Open Collective
            </a>
            <a href={withBase('/support/')} class="inline-flex h-12 items-center gap-2 rounded-full border border-white/30 px-6 font-semibold text-white transition hover:bg-white/10">
              <MessagesSquare className="size-4" aria-hidden="true" /> Get or give help
            </a>
          </div>
        </div>
        <div class="mx-auto -mb-12 w-52 self-end md:-mb-16 md:w-64" aria-hidden="true">
          <Otter pose="wave" class="w-full" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .holt-bob {
      animation: holt-bob 6s ease-in-out infinite;
    }
  }
  @keyframes holt-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }
</style>
