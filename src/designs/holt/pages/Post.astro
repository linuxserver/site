---
import { Image, getImage } from 'astro:assets';
import Layout from '../Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
import ImageLogo from '@/components/shared/ImageLogo.astro';
import PostBody from '@/components/shared/PostBody.astro';
import type { PostProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { formatDateLong, isoDate } from '@/lib/format';
import { postJsonLd } from '@/lib/jsonld';
import { initials } from '@/lib/posts';
import { Clock, Pencil } from 'lucide-react';

type Props = PostProps;
const { post, Content, headings, newer, older, related, images, editUrl } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const og = await getImage({ src: post.hero, width: 1200, format: 'jpg' });
const crumbs = [
  { name: 'Blog', href: '/blog/' },
  { name: post.title, href: post.url.replace(withBase('/'), '/') },
];
---

<Layout
  section="blog"
  title={post.title}
  description={post.excerpt}
  image={post.hero}
  imageAlt={post.heroAlt || undefined}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.updated}
  author={post.byline?.name}
  tags={post.tags.map((t) => t.name)}
  breadcrumbs={crumbs}
  jsonLd={[postJsonLd(post, new URL(og.src, Astro.site).toString(), Astro.site)]}
>
  <article>
    <header class="holt-glow">
      <div class="holt-container max-w-4xl pt-8 pb-10 text-center md:pb-14">
        <Breadcrumbs crumbs={crumbs.slice(0, 1)} class="flex justify-center" />
        <p class="mt-8 flex flex-wrap justify-center gap-2">
          {post.tags.slice(0, 4).map((t) => (
            <a href={t.url} class="rounded-full bg-accent px-3 py-1 text-sm font-semibold text-accent-foreground hover:underline">{t.name}</a>
          ))}
        </p>
        <h1 class="mt-5 font-heading text-4xl leading-[1.05] font-extrabold tracking-tight text-foreground md:text-6xl">{post.title}</h1>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-muted-foreground">
          {
            post.byline && (
              <span class="flex items-center gap-2.5">
                <span class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-otter-magenta to-otter-violet text-sm font-bold text-white" aria-hidden="true">
                  {post.byline.initials || initials(post.byline.name)}
                </span>
                {post.byline.url ? (
                  <a href={post.byline.url} class="font-semibold text-foreground underline-offset-4 hover:underline" rel="author">{post.byline.name}</a>
                ) : (
                  <span class="font-semibold text-foreground">{post.byline.name}</span>
                )}
              </span>
            )
          }
          <time datetime={isoDate(post.date)}>{formatDateLong(post.date)}</time>
          <span class="inline-flex items-center gap-1.5"><Clock className="size-4" aria-hidden="true" /> {post.readingTime} min read</span>
        </div>
      </div>
      <div class="holt-container max-w-6xl">
        <div class:list={['relative -mb-24 overflow-hidden rounded-[2rem] bg-muted shadow-[var(--holt-shadow-lg)] md:-mb-32', post.heroIsDefault ? 'aspect-[21/9]' : 'aspect-[16/9] md:aspect-[2/1]']}>
          <Image src={post.hero} alt={post.heroAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1152px) 1088px, 100vw" class="size-full object-cover" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <div class="holt-container grid max-w-6xl gap-12 pt-36 md:pt-44 xl:grid-cols-[minmax(0,1fr)_15rem]">
      <div class="mx-auto w-full max-w-[44rem] min-w-0">
        <PostBody>
          <Content />
        </PostBody>

        {
          images.length > 0 && (
            <aside aria-labelledby="in-this-post" class="holt-card mt-14 p-6">
              <h2 id="in-this-post" class="font-heading text-xl font-bold text-foreground">Images in this post</h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {images.map((img) => (
                  <li>
                    <a href={withBase(img.url)} class="group flex items-center gap-3 rounded-2xl p-2 hover:bg-muted">
                      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-muted holt-tile p-2"><ImageLogo image={img} size={28} class="size-7" /></span>
                      <span class="min-w-0">
                        <span class="block font-semibold text-foreground group-hover:text-primary">{img.name}</span>
                        <span class="block truncate text-sm text-muted-foreground">{img.summary}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <footer class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-sm text-muted-foreground">
          {post.updated ? <p>Last updated <time datetime={isoDate(post.updated)}>{formatDateLong(post.updated)}</time></p> : <p>Published <time datetime={isoDate(post.date)}>{formatDateLong(post.date)}</time></p>}
          <a href={editUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-[var(--link)] underline-offset-4 hover:underline">
            <Pencil className="size-4" aria-hidden="true" /> Suggest an edit on GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </footer>
      </div>

      {
        toc.length > 2 && (
          <nav aria-labelledby="toc-title" class="hidden xl:block">
            <div class="sticky top-28">
              <h2 id="toc-title" class="text-sm font-semibold text-foreground">On this page</h2>
              <ul class="mt-3 space-y-2 border-l border-border text-sm">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground hover:border-primary hover:text-foreground">{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
    </div>
  </article>

  <nav aria-label="More posts" class="holt-container mt-16 max-w-6xl">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        older && (
          <a href={older.url} rel="prev" class="holt-card holt-lift block p-5">
            <span class="text-sm font-semibold text-muted-foreground">← Older post</span>
            <span class="mt-1 block font-heading text-lg font-bold text-foreground">{older.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a href={newer.url} rel="next" class="holt-card holt-lift block p-5 text-right sm:col-start-2">
            <span class="text-sm font-semibold text-muted-foreground">Newer post →</span>
            <span class="mt-1 block font-heading text-lg font-bold text-foreground">{newer.title}</span>
          </a>
        )
      }
    </div>
  </nav>

  {
    related.length > 0 && (
      <section aria-labelledby="related" class="holt-container mt-20 max-w-6xl">
        <h2 id="related" class="font-heading text-3xl font-bold tracking-tight text-foreground">Keep reading</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )
  }
</Layout>
