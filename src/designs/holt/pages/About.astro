---
import { Image } from 'astro:assets';
import Layout from '../Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Otter from '@/components/shared/Otter.astro';
import type { AboutProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { MISSION, PILLARS } from '@/lib/site';
import { SINCE_YEAR } from '@/lib/stats';

type Props = AboutProps;
const { stats, team, supporters, growth, categories } = Astro.props;
const yearsShown = growth.filter((g) => g.year >= SINCE_YEAR);
const maxTotal = Math.max(...yearsShown.map((g) => g.total));
const maxAdded = Math.max(...yearsShown.map((g) => g.added));
const W = 720;
const H = 300;
const pad = { l: 36, r: 12, t: 28, b: 28 };
const bw = (W - pad.l - pad.r) / yearsShown.length;
const y = (v: number, max: number) => pad.t + (H - pad.t - pad.b) * (1 - v / max);
const line = yearsShown.map((g, i) => `${i ? 'L' : 'M'}${(pad.l + bw * i + bw / 2).toFixed(1)},${y(g.total, maxTotal).toFixed(1)}`).join(' ');
const topCats = categories.slice(0, 8);
const catMax = topCats[0]?.count ?? 1;
const headline = [stats.hubPulls, stats.monthlyPulls, stats.images, stats.stars, stats.arm64, stats.backers];
---

<Layout section="about" title="About us" description={`LinuxServer.io is a volunteer team building and maintaining ${stats.images.value} community Docker images since ${SINCE_YEAR}.`} breadcrumbs={[{ name: 'About', href: '/about/' }]}>
  <PageHero eyebrow="About LinuxServer.io" title="Building and maintaining community images" lede={MISSION}>
    <div slot="aside" class="mx-auto w-64 md:w-80" aria-hidden="true"><Otter pose="float" /></div>
  </PageHero>

  <section aria-labelledby="numbers" class="holt-container py-16 md:py-20">
    <SectionHeading eyebrow="By the numbers" title="A worldwide userbase" id="numbers" description="Our commitment is to the community and our users. Our images are for everyone, and always will be." />
    <dl class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        headline.map((s) => (
          <div class="holt-card p-6">
            <dt class="text-sm text-muted-foreground">{s.label}</dt>
            <dd class="mt-1 font-heading text-4xl font-extrabold text-foreground tabular-nums">
              {s.value}
              {'suffix' in s && s.suffix && <span class="text-primary">{s.suffix}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="growth" class="bg-muted/50 py-16 md:py-20">
    <div class="holt-container grid gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <figure class="holt-card p-6 md:p-8">
        <h2 id="growth" class="font-heading text-2xl font-bold text-foreground">The fleet, year by year</h2>
        <figcaption class="mt-1 text-sm text-muted-foreground">Bars: new images first built that year. Line: total images ever built, including ones since retired.</figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} class="mt-6 w-full" role="img" aria-labelledby="growth-desc">
          <desc id="growth-desc">
            {yearsShown.map((g) => `${g.year}: ${g.added} new, ${g.total} in total`).join('; ')}
          </desc>
          {[0.25, 0.5, 0.75, 1].map((f) => (
            <line x1={pad.l} x2={W - pad.r} y1={y(maxTotal * f, maxTotal)} y2={y(maxTotal * f, maxTotal)} stroke="var(--border)" stroke-dasharray="3 4" />
          ))}
          {[0.5, 1].map((f) => (
            <text x={pad.l - 6} y={y(maxTotal * f, maxTotal) + 4} text-anchor="end" font-size="11" fill="var(--muted-foreground)">{Math.round(maxTotal * f)}</text>
          ))}
          {yearsShown.map((g, i) => (
            <g>
              <rect x={pad.l + bw * i + bw * 0.2} width={bw * 0.6} y={y(g.added, maxAdded * 2.2)} height={H - pad.b - y(g.added, maxAdded * 2.2)} rx="4" fill="var(--chart-2)" opacity="0.35" />
              <text x={pad.l + bw * i + bw / 2} y={y(g.added, maxAdded * 2.2) - 5} text-anchor="middle" font-size="10" fill="var(--muted-foreground)">+{g.added}</text>
              <text x={pad.l + bw * i + bw / 2} y={H - 8} text-anchor="middle" font-size="11" fill="var(--muted-foreground)">{i % 2 === 0 || i === yearsShown.length - 1 ? `’${String(g.year).slice(2)}` : ''}</text>
            </g>
          ))}
          <path d={line} fill="none" stroke="var(--chart-1)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          {yearsShown.map((g, i) => <circle cx={pad.l + bw * i + bw / 2} cy={y(g.total, maxTotal)} r="3.5" fill="var(--card)" stroke="var(--chart-1)" stroke-width="2" />)}
          <text x={pad.l + bw * (yearsShown.length - 1) + bw / 2} y={y(maxTotal, maxTotal) - 6} text-anchor="end" font-size="12" font-weight="600" fill="var(--foreground)">{maxTotal} images</text>
        </svg>
      </figure>
      <div class="holt-card p-6 md:p-8">
        <h2 class="font-heading text-2xl font-bold text-foreground">What people run</h2>
        <p class="mt-1 text-sm text-muted-foreground">Images per category (an image can be in more than one).</p>
        <ul class="mt-6 space-y-3.5">
          {
            topCats.map((c) => (
              <li>
                <a href={withBase(`/images/?category=${encodeURIComponent(c.name)}`)} class="group block">
                  <span class="flex justify-between text-sm">
                    <span class="font-medium text-foreground group-hover:text-primary">{c.name}</span>
                    <span class="text-muted-foreground tabular-nums">{c.count}</span>
                  </span>
                  <span class="mt-1.5 block h-2 overflow-hidden rounded-full bg-muted" aria-hidden="true">
                    <span class="block h-full rounded-full bg-gradient-to-r from-otter-magenta to-otter-violet" style={`width:${(c.count / catMax) * 100}%`} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="how" class="holt-container py-16 md:py-20">
    <SectionHeading eyebrow="How we work" title="What every image gets" id="how" />
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        PILLARS.map((p) => (
          <div class="holt-card p-6">
            <h3 class="font-heading text-xl font-bold text-foreground">{p.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="team" class="holt-container py-8 md:py-12">
    <SectionHeading eyebrow="The team" title={`${team.length} volunteers, all over the world`} id="team" description="The public members of our GitHub organisation. Plenty more people help out in the community every day." />
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        team.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener" class="holt-card holt-lift flex flex-col items-center gap-3 p-5 text-center">
              {m.avatar ? (
                <Image src={m.avatar} alt="" width={80} height={80} class="size-20 rounded-full object-cover ring-4 ring-accent" />
              ) : (
                <span class="size-20 rounded-full bg-muted" />
              )}
              <span class="min-w-0">
                <span class="block truncate font-semibold text-foreground">{m.name ?? m.login}</span>
                <span class="block truncate text-sm text-muted-foreground">@{m.login}</span>
              </span>
              <span class="sr-only">(GitHub profile, opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="thanks" class="holt-container py-16">
    <h2 id="thanks" class="font-heading text-2xl font-bold text-foreground">With thanks to</h2>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {supporters.map((s, i) => (
        <>
          <a href={s.href} target="_blank" rel="noopener" class="font-semibold text-foreground underline decoration-primary/40 underline-offset-4 hover:decoration-primary">{s.name}</a>
          {i < supporters.length - 2 ? ', ' : i === supporters.length - 2 ? ' and ' : ''}
        </>
      ))}
      , plus {stats.backers.value} backers on Open Collective. <a href={withBase('/donate/')} class="font-semibold text-[var(--link)] underline-offset-4 hover:underline">Join them →</a>
    </p>
  </section>
</Layout>
