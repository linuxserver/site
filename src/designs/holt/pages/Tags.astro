---
import Layout from '../Layout.astro';
import PageHero from '../components/PageHero.astro';
import type { TagsProps } from '@/designs/types';
import { tagUrl } from '@/lib/posts';

type Props = TagsProps;
const { tags, authors, totalPosts } = Astro.props;
const max = Math.max(...tags.map((t) => t.count));
const size = (n: number) => 0.875 + (Math.log(n) / Math.log(max)) * 0.875;
---

<Layout section="blog" title="Topics and authors" description={`Every topic and author across ${totalPosts} posts on the LinuxServer.io blog.`} breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: 'Topics', href: '/blog/tags/' }]}>
  <PageHero eyebrow="The blog" title="Topics and authors" lede={`${tags.length} topics across ${totalPosts} posts. Bigger means more posts.`} crumbs={[{ name: 'Blog', href: '/blog/' }, { name: 'Topics', href: '/blog/tags/' }]} compact />

  <div class="holt-container grid gap-14 py-12 md:py-16 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <section aria-labelledby="topics">
      <h2 id="topics" class="font-heading text-2xl font-bold text-foreground">Topics</h2>
      <ul class="mt-6 flex flex-wrap items-baseline gap-x-2 gap-y-3">
        {
          tags.map((t) => (
            <li>
              <a href={tagUrl(t.slug)} class="inline-flex items-baseline gap-1.5 rounded-full border border-border bg-card px-3.5 py-1.5 font-semibold text-foreground transition hover:border-primary/50 hover:text-primary" style={`font-size:${size(t.count).toFixed(3)}rem`}>
                {t.name} <span class="text-[0.75rem] font-medium text-muted-foreground tabular-nums">{t.count}<span class="sr-only"> posts</span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="authors">
      <h2 id="authors" class="font-heading text-2xl font-bold text-foreground">Authors</h2>
      <ul class="mt-6 space-y-2">
        {
          authors.map((a) => (
            <li>
              <a href={a.url} class="holt-card holt-lift flex items-center gap-3.5 p-3.5">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-gradient-to-br from-otter-magenta to-otter-violet text-sm font-bold text-white" aria-hidden="true">{a.initials}</span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold text-foreground">{a.name}</span>
                  <span class="block text-sm text-muted-foreground">{a.role === 'alumni' ? 'Team alumni' : a.role === 'guest' ? 'Guest author' : 'Team'}</span>
                </span>
                <span class="text-sm font-semibold text-foreground tabular-nums">{a.count}<span class="sr-only"> posts</span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
