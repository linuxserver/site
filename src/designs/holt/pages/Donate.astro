---
import Layout from '../Layout.astro';
import PageHero from '../components/PageHero.astro';
import Otter from '@/components/shared/Otter.astro';
import Icon from '@/components/shared/Icon.astro';
import type { DonateProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { DONATE_URL, LINKS } from '@/lib/site';
import { Code2, Heart, MessagesSquare, PenLine, Server } from 'lucide-react';

type Props = DonateProps;
const { stats, supporters, backers } = Astro.props;
const help = [
  { icon: MessagesSquare, title: 'Help others', body: 'Answer a question on Discord or the forum. Most support comes from the community.', href: LINKS.discord, label: 'Join Discord' },
  { icon: Code2, title: 'Contribute', body: 'Pull requests are welcome on every image, and on our tooling.', href: LINKS.github, label: 'Find a repository' },
  { icon: PenLine, title: 'Write for the blog', body: 'Have a guide worth sharing? Posts are Markdown files in a pull request.', href: withBase('/blog/'), label: 'Read the blog' },
];
---

<Layout section="donate" title="Donate" description={`Everyone at LinuxServer.io is a volunteer. Join ${stats.backers.value} backers on Open Collective and help keep the servers and build hardware running.`} breadcrumbs={[{ name: 'Donate', href: '/donate/' }]}>
  <PageHero eyebrow="Donate" title="Keep the otters swimming" lede="Everyone at LinuxServer.io is a volunteer. We don’t get paid to do this; we make the most of our free time to keep improving what we do. Even the smallest donation helps keep everything running.">
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={DONATE_URL} class="inline-flex h-12 items-center gap-2 rounded-full bg-primary px-6 font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition hover:brightness-110">
        <Heart className="size-4" aria-hidden="true" /> Donate on Open Collective
      </a>
      <p class="text-muted-foreground"><strong class="text-foreground">{stats.backers.value}</strong> people and organisations already back us.</p>
    </div>
    <div slot="aside" class="mx-auto w-64 md:w-80" aria-hidden="true"><Otter pose="float" /></div>
  </PageHero>

  <section aria-labelledby="where" class="holt-container py-16 md:py-20">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="holt-card p-7 md:col-span-2">
        <h2 id="where" class="font-heading text-2xl font-bold text-foreground">Where the money goes</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Donations help keep everything behind our {stats.images.value} images up and running, so we can keep providing them for free. Our budget
          lives on Open Collective, where every contribution and expense is public.
        </p>
        <a href={LINKS.opencollective} class="mt-5 inline-flex items-center gap-2 font-semibold text-[var(--link)] underline-offset-4 hover:underline">
          <Icon name="opencollective" class="size-4" /> See our open budget →
        </a>
      </div>
      <div class="holt-card flex flex-col justify-center p-7">
        <Server className="size-7 text-primary" aria-hidden="true" />
        <p class="mt-3 font-heading text-4xl font-extrabold text-foreground tabular-nums">{stats.updatedThisWeek.value}</p>
        <p class="text-muted-foreground">images rebuilt in the last week alone. Keeping that pipeline running is what your support makes possible.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="supporters" class="bg-muted/50 py-16 md:py-20">
    <div class="holt-container">
      <h2 id="supporters" class="font-heading text-3xl font-bold tracking-tight text-foreground">Supporters</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted-foreground">
        We wouldn’t be where we are without our users, but special thanks go to these organisations, who have donated time, credit or hardware.
      </p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          supporters.map((s) => (
            <li class="holt-card p-6">
              <h3 class="font-heading text-xl font-bold text-foreground">
                <a href={s.href} target="_blank" rel="noopener" class="underline-offset-4 hover:text-primary hover:underline">
                  {s.name}<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </h3>
              <p class="mt-2 text-muted-foreground">{s.contribution}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="other-ways" class="holt-container py-16 md:py-20">
    <h2 id="other-ways" class="font-heading text-3xl font-bold tracking-tight text-foreground">Other ways to help</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        help.map((h) => (
          <div class="holt-card p-6">
            <h.icon className="size-6 text-primary" aria-hidden="true" />
            <h3 class="mt-3 font-heading text-xl font-bold text-foreground">{h.title}</h3>
            <p class="mt-2 text-muted-foreground">{h.body}</p>
            <a href={h.href} class="mt-4 inline-flex font-semibold text-[var(--link)] underline-offset-4 hover:underline">{h.label} →</a>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
