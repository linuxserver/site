---
import Layout from '../Layout.astro';
import PageHero from '../components/PageHero.astro';
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';
import type { BlogListProps } from '@/designs/types';
import { withBase } from '@/lib/base';
import { tagUrl } from '@/lib/posts';
import { Rss } from 'lucide-react';

type Props = BlogListProps;
const { kind, heading, description, page, topTags, tag, author } = Astro.props;
const first = page.currentPage === 1 && kind === 'all' ? page.data[0] : undefined;
const rest = first ? page.data.slice(1) : page.data;
const crumbs =
  kind === 'all'
    ? [{ name: 'Blog', href: '/blog/' }]
    : [
        { name: 'Blog', href: '/blog/' },
        kind === 'tag' ? { name: 'Topics', href: '/blog/tags/' } : { name: 'Authors', href: '/blog/tags/#authors' },
        { name: heading, href: kind === 'tag' ? `/blog/tags/${tag!.slug}/` : `/blog/authors/${author!.id}/` },
      ];
const title = kind === 'all' ? (page.currentPage > 1 ? `Blog, page ${page.currentPage}` : 'Blog') : kind === 'tag' ? `Posts tagged “${heading}”` : `Posts by ${heading}`;
---

<Layout section="blog" title={title} description={description} breadcrumbs={crumbs} noindex={kind === 'tag' && (tag?.count ?? 0) < 2}>
  <PageHero
    eyebrow={kind === 'all' ? `${page.total} posts since 2013` : kind === 'tag' ? 'Topic' : author?.role === 'alumni' ? 'Author · team alumni' : 'Author'}
    title={kind === 'all' ? 'The blog' : heading}
    lede={kind === 'all' ? 'News, guides, release notes and the occasional opinion from the people who build the images.' : description}
    crumbs={kind === 'all' ? undefined : crumbs}
    compact={kind !== 'all'}
  >
    {
      author?.github && (
        <p class="mt-4">
          <a href={`https://github.com/${author.github}`} target="_blank" rel="noopener" class="font-semibold text-[var(--link)] underline-offset-4 hover:underline">
            @{author.github} on GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      )
    }
    <div class="mt-8 flex flex-wrap items-center gap-2">
      {
        topTags.map((t) => (
          <a
            href={tagUrl(t.slug)}
            aria-current={tag?.slug === t.slug ? 'page' : undefined}
            class="rounded-full border border-border bg-card px-3.5 py-1.5 text-sm font-medium text-foreground transition hover:border-primary/50 hover:text-primary aria-[current=page]:border-primary aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
          >
            {t.name}
          </a>
        ))
      }
      <a href={withBase('/blog/tags/')} class="px-2 text-sm font-semibold text-[var(--link)] underline-offset-4 hover:underline">All topics →</a>
      <a href={withBase('/blog/rss.xml')} class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3.5 py-1.5 text-sm font-medium text-foreground hover:bg-muted">
        <Rss className="size-4 text-primary" aria-hidden="true" /> RSS
      </a>
    </div>
  </PageHero>

  <div class="holt-container py-12 md:py-16">
    <h2 class="sr-only">Posts</h2>
    {first && <div class="mb-8"><PostCard post={first} size="feature" eager /></div>}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((p, i) => <PostCard post={p} eager={!first && i < 3} />)}
    </div>
    <Pagination page={page} label="Blog pages" />
  </div>
</Layout>
