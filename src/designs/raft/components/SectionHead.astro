---
/** Section heading: mono eyebrow, h2, optional description and a "see all" link. */
import { ArrowRight } from 'lucide-react';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  link?: { label: string; href: string };
  id?: string;
  class?: string;
}
const { eyebrow, title, description, link, id, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between', className]}>
  <div class="max-w-2xl">
    <p class="raft-eyebrow"><span class="text-primary" aria-hidden="true">//</span> {eyebrow}</p>
    <h2 id={id} class="mt-2 text-2xl font-semibold tracking-tight md:text-[2rem] md:leading-tight">{title}</h2>
    {description && <p class="mt-3 text-muted-foreground">{description}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-foreground hover:text-primary">
        {link.label}
        <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    )
  }
</div>
