---
import Layout from '../Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Catalog from '../islands/Catalog';
import type { ImagesProps } from '@/designs/types';
import { BASE } from '@/lib/base';
import { formatDate } from '@/lib/format';
import { itemListJsonLd } from '@/lib/jsonld';

type Props = ImagesProps;
const { cards, categories, stats, snapshotDate } = Astro.props;
const active = cards.filter((c) => !c.deprecated);
---

<Layout
  section="images"
  title="Docker images"
  description={`Browse all ${stats.images.value} LinuxServer.io Docker images: search, filter by category and architecture, and get a compose file for each.`}
  breadcrumbs={[{ name: 'Images', href: '/images/' }]}
  jsonLd={[itemListJsonLd('LinuxServer.io Docker images', active.map((c) => ({ name: c.name, url: c.url })), Astro.site)]}
>
  <PageHeader
    eyebrow="Catalogue"
    title={`${stats.images.value} images, one standard`}
    lede="Every image shares the same base, the same PUID/PGID conventions and the same documentation format. Find yours, then copy a compose file."
    crumbs={[{ name: 'Images', href: '/images/' }]}
  >
    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
      {
        [stats.monthlyPulls, stats.arm64, stats.updatedThisWeek].map((x) => (
          <div class="flex items-baseline gap-2">
            <dt class="sr-only">{x.label}</dt>
            <dd class="text-foreground">{x.value}</dd>
            <dd class="text-muted-foreground" aria-hidden="true">{x.label}</dd>
          </div>
        ))
      }
      <div class="flex items-baseline gap-2">
        <dt class="text-muted-foreground">updated</dt>
        <dd><time datetime={snapshotDate.toISOString()}>{formatDate(snapshotDate)}</time></dd>
      </div>
    </dl>
  </PageHeader>

  <div class="raft-container pt-10">
    <Catalog client:load cards={cards} categories={categories} snapshot={snapshotDate.toISOString()} base={BASE} />
  </div>
</Layout>
