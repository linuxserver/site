---
import type { Crumb } from '@/lib/seo';
import { withBase } from '@/lib/base';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...crumbs];
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted-foreground">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === all.length - 1 ? (
            <span aria-current="page" class="text-foreground">
              {c.name}
            </span>
          ) : (
            <a href={withBase(c.href)} class="hover:text-foreground">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
