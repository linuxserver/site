---
/** Card for an image in a grid. */
import ImageLogo from '@/components/ImageLogo.astro';
import type { Image } from '@/lib/images';
import { withBase } from '@/lib/base';
import { compact } from '@/lib/format';
import { Download, Star } from 'lucide-react';

interface Props {
  image: Image;
}
const { image } = Astro.props;
---

<article class="raft-panel raft-glow-edge relative flex flex-col p-4 transition-colors hover:bg-muted/40">
  <div class="flex items-start gap-3">
    <span class="grid size-11 shrink-0 place-items-center rounded-md border border-[var(--raft-hair)] bg-[var(--raft-surface)] p-1.5">
      <ImageLogo image={image} size={32} class="size-8" />
    </span>
    <div class="min-w-0">
      <h3 class="truncate font-semibold">
        <a href={withBase(image.url)} class="after:absolute after:inset-0 after:rounded-[inherit] after:content-['']">{image.name}</a>
      </h3>
      <p class="truncate font-mono text-xs text-muted-foreground">{image.version}</p>
    </div>
  </div>
  <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">{image.summary}</p>
  <div class="mt-auto flex items-center gap-4 pt-4 font-mono text-xs text-muted-foreground tabular-nums">
    <span class="inline-flex items-center gap-1"><Download className="size-3.5" aria-hidden="true" />{compact(image.monthly_pulls)}<span class="sr-only"> pulls per month</span></span>
    <span class="inline-flex items-center gap-1"><Star className="size-3.5" aria-hidden="true" />{compact(image.stars)}<span class="sr-only"> GitHub stars</span></span>
    {image.arm64 && <span class="ml-auto rounded border border-[var(--raft-hair)] px-1.5 py-px">arm64</span>}
  </div>
</article>
