---
/**
 * The mascot, drawn to match the logo's gradient. Decorative unless `label` is given.
 *
 *   peek   head and paws over an edge. Position it so the bottom ~8% overlaps the thing it peeks over
 *          (a card, a footer). `ledge` draws its own edge instead.
 *   wave   peek, with one paw up, saying hello
 *   float  floating on its back, holding a container. Water included
 */
import { uid } from '@/lib/uid';

interface Props {
  pose?: 'peek' | 'wave' | 'float';
  class?: string;
  label?: string;
  ledge?: boolean;
}
const { pose = 'peek', class: className, label, ledge = false } = Astro.props;
const id = uid('ot');
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---

{
  pose === 'float' ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 30 320 160"
      class={className}
      style="-webkit-mask-image:linear-gradient(to right,transparent,#000 9%,#000 91%,transparent);mask-image:linear-gradient(to right,transparent,#000 9%,#000 91%,transparent)"
      {...a11y}
    >
      <defs>
        <linearGradient id={`${id}f`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff4f97" />
          <stop offset=".55" stop-color="#d93b92" />
          <stop offset="1" stop-color="#7142b7" />
        </linearGradient>
        <linearGradient id={`${id}w`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#4179d4" stop-opacity=".28" />
          <stop offset="1" stop-color="#4179d4" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M246 128C270 124 292 116 306 104C300 122 280 136 250 142Z" fill="#a8358f" />
      <path d="M74 120C74 92 120 86 170 88C220 90 256 100 256 124C256 146 214 150 170 150C120 150 74 146 74 120Z" fill={`url(#${id}f)`} />
      <path d="M100 112C104 98 140 96 172 98C206 100 232 106 232 118C220 112 190 110 166 110C138 110 114 114 100 112Z" fill="#ffe6f1" />
      <ellipse cx="236" cy="96" rx="11" ry="16" transform="rotate(20 236 96)" fill="#a8358f" />
      <ellipse cx="254" cy="102" rx="10" ry="15" transform="rotate(35 254 102)" fill="#93308a" />
      <g transform="rotate(-18 72 96)">
        <ellipse cx="54" cy="88" rx="7" ry="6.5" fill="#c2338a" />
        <ellipse cx="114" cy="88" rx="7" ry="6.5" fill="#c2338a" />
        <path d="M44 120C40 92 56 66 84 66C112 66 128 92 124 120C112 128 56 128 44 120Z" fill={`url(#${id}f)`} />
        <path d="M56 120C52 108 60 100 72 100C78 100 80 102 84 102C88 102 90 100 96 100C108 100 116 108 112 120C100 126 68 126 56 120Z" fill="#ffe6f1" />
        <ellipse cx="74" cy="110" rx="12" ry="9" fill="#fff3f8" />
        <ellipse cx="94" cy="110" rx="12" ry="9" fill="#fff3f8" />
        <path d="M70 87q4-4 8 0M90 87q4-4 8 0" stroke="#24093d" stroke-width="2.6" fill="none" stroke-linecap="round" />
        <path d="M77 99Q84 95 91 99Q90 104 84 106Q78 104 77 99Z" fill="#24093d" />
        <path d="M84 106v2.5M84 108.5q-4 4-8 1.5M84 108.5q4 4 8 1.5" stroke="#24093d" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <path d="M66 108Q52 104 40 106M66 113Q54 115 42 120M102 108Q116 104 128 106M102 113Q114 115 126 120" stroke="#9b4fc7" stroke-width="1.2" stroke-linecap="round" opacity=".75" fill="none" />
      </g>
      <g stroke-linejoin="round" stroke-width="4">
        <path d="M153 40L177 52L153 64L129 52Z" fill="#9dbdf2" stroke="#9dbdf2" />
        <path d="M129 52L153 64L153 90L129 78Z" fill="#4179d4" stroke="#4179d4" />
        <path d="M153 64L177 52L177 78L153 90Z" fill="#5a4fc4" stroke="#5a4fc4" />
      </g>
      <ellipse cx="129" cy="82" rx="9" ry="7.5" transform="rotate(-35 129 82)" fill="#b8378e" />
      <ellipse cx="178" cy="78" rx="9" ry="7.5" transform="rotate(35 178 78)" fill="#b8378e" />
      <path d="M0 140Q20 132 40 140T80 140T120 140T160 140T200 140T240 140T280 140T320 140V190H0Z" fill={`url(#${id}w)`} />
      <path d="M0 140Q20 132 40 140T80 140T120 140T160 140T200 140T240 140T280 140T320 140" stroke="#4179d4" stroke-opacity=".55" stroke-width="2.5" fill="none" />
      <path d="M40 162h30M120 170h46M220 160h36M262 176h24" stroke="#4179d4" stroke-opacity=".35" stroke-width="2" stroke-linecap="round" fill="none" />
    </svg>
  ) : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox={`40 40 ${pose === 'wave' ? 182 : 160} ${ledge ? 106 : 104}`} class={className} {...a11y}>
      <defs>
        <linearGradient id={`${id}f`} x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#ff4f97" />
          <stop offset=".5" stop-color="#d93b92" />
          <stop offset="1" stop-color="#7142b7" />
        </linearGradient>
        <linearGradient id={`${id}p`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#c2338a" />
          <stop offset="1" stop-color="#6a3ab0" />
        </linearGradient>
      </defs>
      <ellipse cx="62" cy="72" rx="10" ry="9" fill="#c2338a" />
      <ellipse cx="178" cy="72" rx="10" ry="9" fill="#c2338a" />
      <ellipse cx="62.5" cy="73" rx="4.5" ry="4" fill="#450284" opacity=".5" />
      <ellipse cx="177.5" cy="73" rx="4.5" ry="4" fill="#450284" opacity=".5" />
      <path d="M50 134C44 96 62 50 120 50C178 50 196 96 190 134Z" fill={`url(#${id}f)`} />
      <path d="M70 134C66 116 74 100 92 98C100 97 108 100 120 100C132 100 140 97 148 98C166 100 174 116 170 134Z" fill="#ffe6f1" />
      <ellipse cx="104" cy="110" rx="19" ry="14" fill="#fff3f8" />
      <ellipse cx="136" cy="110" rx="19" ry="14" fill="#fff3f8" />
      <g fill="#d93b92" opacity=".45">
        <circle cx="96" cy="108" r="1.6" />
        <circle cx="102" cy="113" r="1.6" />
        <circle cx="94" cy="115" r="1.6" />
        <circle cx="144" cy="108" r="1.6" />
        <circle cx="138" cy="113" r="1.6" />
        <circle cx="146" cy="115" r="1.6" />
      </g>
      <circle cx="92" cy="80" r="6.5" fill="#24093d" />
      <circle cx="148" cy="80" r="6.5" fill="#24093d" />
      <circle cx="94.2" cy="77.8" r="2.1" fill="#fff" />
      <circle cx="150.2" cy="77.8" r="2.1" fill="#fff" />
      <path d="M109 96Q120 90 131 96Q130 104 120 106Q110 104 109 96Z" fill="#24093d" />
      <path d="M114 95.5q4-2 8-.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" fill="none" opacity=".6" />
      <path d="M120 106v4M120 110q-6 6-12 2M120 110q6 6 12 2" stroke="#24093d" stroke-width="2.4" fill="none" stroke-linecap="round" />
      <path
        d="M86 106Q66 100 48 100M86 112Q66 112 50 116M88 118Q70 122 56 130M154 106Q174 100 192 100M154 112Q174 112 190 116M152 118Q170 122 184 130"
        stroke="#9b4fc7"
        stroke-width="1.5"
        stroke-linecap="round"
        opacity=".75"
        fill="none"
      />
      {ledge && (
        <>
          <rect x="44" y="134" width="152" height="9" rx="4.5" fill="var(--otter-ledge-edge, #d9cdee)" />
        </>
      )}
      <g fill={`url(#${id}p)`}>
        <path d="M68 142v-14a13 13 0 0 1 26 0v14z" />
        {pose === 'wave' ? (
          <g class="otter-wave" style="transform-origin:190px 128px">
            <path d="M178 132v-34a13 13 0 0 1 26 0v34z" transform="rotate(14 191 130)" />
          </g>
        ) : (
          <path d="M146 142v-14a13 13 0 0 1 26 0v14z" />
        )}
      </g>
      <path
        d={pose === 'wave' ? 'M76 124v6M81 122v8M86 124v6' : 'M76 124v6M81 122v8M86 124v6M154 124v6M159 122v8M164 124v6'}
        stroke="#24093d"
        stroke-width="1.5"
        opacity=".35"
        stroke-linecap="round"
      />
      {pose === 'wave' && <path d="M210 70q6 5 5 13M216 60q10 8 8 22" stroke="#d93b92" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".6" />}
    </svg>
  )
}

<style>
  @media (prefers-reduced-motion: no-preference) {
    .otter-wave {
      animation: otter-wave 2.4s ease-in-out infinite;
    }
  }
  @keyframes otter-wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    70% { transform: rotate(-14deg); }
    80% { transform: rotate(8deg); }
    90% { transform: rotate(-8deg); }
  }
</style>
