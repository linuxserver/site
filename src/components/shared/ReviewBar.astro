---
/**
 * Design review only: a small bar to jump to the same page in the other designs.
 * Rendered when PUBLIC_REVIEW=1 (set by `npm run build`); delete with the other designs.
 */
const DESIGNS = [
  { id: 'holt', name: 'Holt' },
  { id: 'raft', name: 'Raft' },
  { id: 'current', name: 'Current' },
];
const current = import.meta.env.DESIGN as string;
const show = import.meta.env.PUBLIC_REVIEW === '1';
/** Where the review build lives: '/' locally, '/site/' on GitHub Pages. */
const root = ((import.meta.env.PUBLIC_REVIEW_ROOT as string | undefined) ?? '/').replace(/\/?$/, '/');
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
---

{
  show && (
    <nav
      aria-label="Design review"
      class="fixed right-3 bottom-3 z-[60] flex items-center gap-1 rounded-full border border-white/15 bg-neutral-950/90 p-1 pl-3 text-xs text-white shadow-2xl backdrop-blur print:hidden"
      style="font-family: ui-sans-serif, system-ui, sans-serif"
    >
      <a href={root} class="mr-1 font-semibold text-white/80 hover:text-white">
        Designs
      </a>
      {DESIGNS.map((d) => (
        <a
          href={`${root}${d.id}${path}`}
          aria-current={d.id === current ? 'true' : undefined}
          class:list={[
            'rounded-full px-3 py-1.5 font-medium transition-colors',
            d.id === current ? 'bg-white text-neutral-950' : 'text-white/80 hover:bg-white/10 hover:text-white',
          ]}
        >
          {d.name}
        </a>
      ))}
    </nav>
  )
}
