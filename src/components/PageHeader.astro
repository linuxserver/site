---
/** Top of an inner page: grid + aurora backdrop, breadcrumbs, eyebrow, h1 and lede. */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lede, crumbs } = Astro.props;
---

<div class="relative overflow-hidden border-b border-[var(--raft-hair)]">
  <div class="raft-aurora pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="raft-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="raft-container relative py-12 md:py-16">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <p class="raft-eyebrow mt-6"><span class="text-primary" aria-hidden="true">//</span> {eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">{title}</h1>
    {lede && <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{lede}</p>}
    <slot />
  </div>
</div>
