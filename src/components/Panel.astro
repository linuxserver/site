---
/** A "window": hairline panel with a title bar (traffic lights, mono title, optional actions slot). */
interface Props {
  title?: string;
  class?: string;
  bodyClass?: string;
  as?: 'div' | 'section' | 'aside' | 'figure';
  labelledby?: string;
}
const { title, class: className, bodyClass, as: Tag = 'div', labelledby } = Astro.props;
---

<Tag class:list={['raft-panel overflow-hidden', className]} aria-labelledby={labelledby}>
  {
    title !== undefined && (
      <div class="flex h-10 items-center gap-3 border-b border-[var(--raft-hair)] bg-[var(--raft-surface)] px-3.5">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-[#ff5f57]/80" />
          <span class="size-2.5 rounded-full bg-[#febc2e]/80" />
          <span class="size-2.5 rounded-full bg-[#28c840]/80" />
        </span>
        <span class="truncate font-mono text-xs text-muted-foreground">{title}</span>
        <div class="ml-auto flex items-center gap-1">
          <slot name="actions" />
        </div>
      </div>
    )
  }
  <div class={bodyClass}>
    <slot />
  </div>
</Tag>
